		local fbm = L.new("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, fb)
		L.fx(0.45, function(k) local r = (1 + 17 * L.outQuad(k)) * s * 10 fbm.Scale = Vector3.one * r fb.Color = W:Lerp(C1, k) fb.Transparency = c01(k * 1.4 - 0.1) end, { fb })
		local sh, shm = L.mesh("sphere.mesh", "smoke.png", BLACK, 1)
		L.fx(1, function(k) local r = (3 + 22 * L.outQuad(k)) * s shm.Scale = Vector3.new(r, r * 0.8, r) sh.CFrame = CFrame.new(pos) * CFrame.Angles(0, -k * 3, 0)
			sh.Transparency = 0.25 + 0.75 * k end, { sh })
