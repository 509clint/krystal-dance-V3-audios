	System._readJSONSafe = function(path)
		if not (env.isfile and env.readfile) then return nil, "unreadable" end
		if not env.isfile(path) then return {}, "missing" end
		local okR, raw = pcall(env.readfile, path)
		if not okR or type(raw) ~= "string" then return nil, "unreadable" end
		local okD, dec = pcall(HS.JSONDecode, HS, raw)
		if okD and type(dec) == "table" then return dec, "ok" end
		local bak = path .. ".bak"
		if env.isfile(bak) then
			local okB, rawB = pcall(env.readfile, bak)
			if okB and type(rawB) == "string" then
				local okDB, decB = pcall(HS.JSONDecode, HS, rawB)
				if okDB and type(decB) == "table" then
					warn("[RoClothes] " .. path .. " was corrupt; restored from the backup")
					return decB, "restored"
				end
			end
		end
		warn("[RoClothes] " .. path .. " was corrupt and has no good backup; starting empty (kept as .bad)")
		if env.writefile then pcall(env.writefile, path .. ".bad", raw) end
		return {}, "corrupt"
	end



