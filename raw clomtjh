					EmissionDirection = Enum.NormalId.Top, Speed = NR(2, 4), Lifetime = NR(0.4, 0.7), Size = NS({ K(0, 0.9), K(1, 0) }),
					Transparency = NS({ K(0, 0.2), K(1, 1) }), Acceleration = Vector3.new(0, 5, 0) })
			elseif i == 2 then
				em = L.pe(ep, { Texture = L.T("snow.png"), Color = CS(W, cols[2]), LightEmission = 0.6, Brightness = 2, Shape = Enum.ParticleEmitterShape.Disc,
					EmissionDirection = Enum.NormalId.Top, Speed = NR(0.5, 1.5), Lifetime = NR(0.8, 1.2), Size = NS({ K(0, 0.4), K(1, 0) }),
					Transparency = NS({ K(0, 0.2), K(1, 1) }), Acceleration = Vector3.new(0, 1, 0) })
			else
				em = moteE(ep, { Color = CS(W, cols[3]), Shape = Enum.ParticleEmitterShape.Disc, EmissionDirection = Enum.NormalId.Top, Speed = NR(3, 6),
					Lifetime = NR(0.2, 0.35), Drag = 3, Acceleration = Vector3.zero })
			end
			local a0, a1 = own(L.att(pos + Vector3.new(0, 0.5, 0))), own(L.att(CEN))
			local b = own(L.beam(a0, a1, { TextureMode = Enum.TextureMode.Wrap, TextureLength = 3, TextureSpeed = 4, Width0 = 1.2, Width1 = 0.5, LightEmission = 0.4,
				Brightness = 4, Color = CS(cols[i], cols[i]:Lerp(W, 0.4)), Transparency = NS(1) }))
			nodes[i] = { pos = pos, orb = orb, f = f, cset = cset, bset = bset, em = em, b = b, t0 = 0.15 + (i - 1) * 0.18, rot = rnd(0, 6) }
		end
		local core = own(L.part({ Size = Vector3.one, CFrame = CFrame.new(CEN) }))
		local coreF = flareE(core, { Rate = 0, Lifetime = NR(0.15), Size = NS(6) })

		local pillarP = own(L.part({ Size = Vector3.new(2.5, 1, 2.5), CFrame = CFrame.new(o + Vector3.new(0, 0.5, 0)) }))
		local pillarE = L.pe(pillarP, { Texture = L.T("flame.png"), Color = CS(W, cols[1]), LightEmission = 1, Brightness = 4, Shape = Enum.ParticleEmitterShape.Box,
			EmissionDirection = Enum.NormalId.Top, Speed = NR(14, 22), Lifetime = NR(0.35, 0.6), SpreadAngle = Vector2.new(8, 8), Size = NS({ K(0, 1.6), K(1, 0.3) }),
			Transparency = NS({ K(0, 0.1), K(1, 1) }) })
		local fA, fB = own(L.att(o)), own(L.att(o + Vector3.new(0, 16, 0)))
		local fBeam = own(L.beam(fA, fB, { Texture = L.T("softbeam.png"), TextureMode = Enum.TextureMode.Stretch, Width0 = 0.1, Width1 = 0.1, Brightness = 5,
			Segments = 2, Color = CS(W, cols[1]), Transparency = NS(1) }))
		local fired, iced, struck = false, false, false
		local zapT = 0
		L.fx(DUR, function(k, t)
			local out = c01((t - BOLT - 0.3) / 0.5)
			for i, nd in ipairs(nodes) do

				local u = c01((t - nd.t0) / 0.35)
				local target = nd.pos + Vector3.new(0, 0.6, 0)
				nd.orb.CFrame = CFrame.new(CEN:Lerp(target, L.outQuad(u)) + Vector3.new(0, 3 * math.sin(math.pi * u), 0))
				nd.orb.Transparency = (u < 1) and 0 or 1
				nd.f.Rate = (u > 0 and u < 1) and 20 or 0
				if u >= 1 and not nd.landed then
					nd.landed = true
					L.groundWave(nd.pos, "ring_c.png", cols[i], 1, 8, 0.4, 2)
					burstP.CFrame = CFrame.new(target) burst:Emit(12)
					if i == 2 then shards(target, 5, 12, 0.5, cols[2]) end
				end
				local ca = nd.landed and c01((t - nd.t0 - 0.35) / 0.2) or 0
				local beamOn = t >= BEAM + (i - 1) * 0.06 and t < BOLT + 0.1
				nd.cset(nd.pos + Vector3.new(0, 0.1, 0), math.max(0.01, 6 * L.outBack(ca) * (1 + 0.2 * out)), nd.rot + t * 1.2, ca > 0 and math.max(0.06, out) or 1, 1.5, nil,
					(1 - ca) + (beamOn and 0.12 or 0))
				nd.bset(CFrame.new(nd.pos + Vector3.new(0, 0.05, 0)), math.max(0.01, 6.8 * L.outBack(ca)), ca > 0 and math.max(0.4, out) or 1)
				nd.em.Rate = (nd.landed and out < 1) and (i == 3 and 40 or 25) or 0
				nd.b.Transparency = NS(beamOn and 0.15 or 1)
				nd.b.Width0 = 1 + 0.35 * math.sin(t * 30 + i)
			end

			zapT += L.lastDt or 0.016
			if nodes[3].landed and t < BOLT and zapT > 0.1 then
				zapT = 0
				local c = nodes[3].pos + Vector3.new(0, 0.3, 0)
				local a1, a2 = rnd(0, 6.28), rnd(0, 6.28)
				L.bolt(c + Vector3.new(math.cos(a1), 0, math.sin(a1)) * 2.3, c + Vector3.new(math.cos(a2), 0.6, math.sin(a2)) * 2.3, { w = 0.15, life = 0.1, col = W, glow = cols[3], segs = 5 })
			end
			coreF.Rate = (t >= BEAM and t < FIRE) and 30 or 0

			if not fired and t >= FIRE then
				fired = true
				L.groundWave(o, "ring_c.png", cols[1], 2, 12, 0.45, 2.2)
				light.Brightness = 6
			end
			pillarE.Rate = (t >= FIRE and t < FIRE + 0.25) and 320 or 0
			local fu = c01((t - FIRE) / 0.08) * (1 - c01((t - FIRE - 0.2) / 0.4))
			fBeam.Width0, fBeam.Width1 = 5 * fu, 3 * fu
			fBeam.Transparency = NS({ K(0, 1 - 0.85 * fu), K(1, 1) })
			if not iced and t >= ICE then
				iced = true
				shards(o + Vector3.new(0, 1, 0), 14, 22, 0.7, cols[2])
				L.groundWave(o, "cracks_b.png", cols[2], 2, 13, 0.7, 2)
				burstP.CFrame = CFrame.new(o + Vector3.new(0, 1, 0)) burst:Emit(20)
			end
			if not struck and t >= BOLT then
				struck = true
				L.strike(o + Vector3.new(rnd(-2, 2), 30, rnd(-2, 2)), o + Vector3.new(0, 0.2, 0), { col = W, glow = cols[3], w = 0.7, life = 0.3, forks = 4 })
				appear(W, hideTok)
				for i = 1, 3 do L.groundWave(o, "ring_c.png", cols[i], 2 + i, 14 + i * 5, 0.5 + i * 0.12, 2.2) end
				burstP.CFrame = CFrame.new(o + Vector3.new(0, 2, 0)) burst:Emit(50)
			end
		end, objs)
		task.delay(DUR + 0.1, function() setHidden(false, hideTok) end)
	end


	shorts[5] = function()
		local o = ch.feet
		local DUR, RISE0, RISE = 3.0, 1.4, 2.0
		local hideTok = setHidden(true)
		local S = L.screen(DUR)
		local objs = {}
		local function own(x) objs[#objs + 1] = x return x end
		local spec = {
			{ size = 13, h = 16, fall = 0.45, t0 = 0, tex = "mcircle.png", col = C1 },
			{ size = 9.5, h = 18, fall = 0.33, t0 = 0.55, tex = "runering.png", col = C2 },
			{ size = 6.5, h = 20, fall = 0.24, t0 = 0.95, tex = "mcircle.png", col = C2 },
		}
		local seals = {}
		for i, sp in ipairs(spec) do
			local p, m, set = circle(sp.tex, sp.col, 1.6) own(p)
			seals[i] = { p = p, sp = sp, set = set, land = sp.t0 + sp.fall, rot = rnd(0, 6), y0 = 0.1 + i * 0.03 }
		end

		local crB, crBSet = backing()
		local crP, crM = mmesh("disc.mesh", "cracks_b.png", C2, 1.6)
		crP.Transparency = 1
		local crHot = 0
		local function startCrater()
			L.fx(DUR + 1.5, function(k, t)
				local g = L.outQuad(t / 0.25)
				crBSet(CFrame.new(o + Vector3.new(0, 0.03, 0)), 5 + 19 * g, math.max(0.3, c01((t - DUR - 0.5) / 1)))
				crM.Scale = Vector3.new(4 + 18 * g, 1, 4 + 18 * g)
				crP.CFrame = CFrame.new(o + Vector3.new(0, 0.06, 0))
				crP.Transparency = math.max(0.06, c01((t - DUR - 0.3) / 1.2))
				capTint(crM, C2:Lerp(C1, c01((t - 0.5) / 1.5)), 1.6, math.max(1 - c01(t / 0.4), 1 - c01((os.clock() - crHot) / 0.35)))
			end, { crB, crP })
		end
		local body, risen = nil, false
		L.fx(DUR, function(k, t)
			for i, s in ipairs(seals) do
				local sp = s.sp
				local u = L.inQuad((t - sp.t0) / sp.fall)
				local y = s.y0 + sp.h * (1 - u)
				if not s.landed and t >= s.land then
					s.landed = true
					S:shake(0.8 + i * 0.5, 0.25)
					L.groundWave(o, "ring_c.png", i == 3 and W or sp.col, sp.size * 0.5, sp.size * 2, 0.45, 2)
					burstP.CFrame = CFrame.new(o + Vector3.new(0, 0.5, 0)) burst:Emit(14 + i * 8) burstG:Emit(4 + i * 3)
					light.Brightness = 4 + i * 2
					crHot = os.clock()
					if i == 1 then startCrater() end
				end

				local peel = L.outQuad((t - (RISE0 + (i - 1) * 0.15)) / 0.5)
				local py = y + peel * (1.5 + i * 2.5)
				if not s.gone and t >= RISE + 0.12 then
					s.gone = true
					s.p.Transparency = 1
					burstP.CFrame = CFrame.new(o + Vector3.new(0, py, 0)) burstG:Emit(10) burst:Emit(10)
				end
				if not s.gone then
					local hot = s.landed and (1 - c01((t - s.land) / 0.4)) or 0
					local spin = s.landed and (0.6 + 3 * peel) or 4
					s.set(o + Vector3.new(0, py, 0), sp.size * (1 - 0.25 * peel), s.rot + t * spin * (i % 2 == 0 and -1 or 1), t >= sp.t0 and 0.06 or 1, 1.6, nil, math.max(hot, 0.4 * peel))
				end
			end
			if not body and t >= RISE0 then body = summonBody(C2, RISE - RISE0 + 0.05) end
			if body and not risen then
				local ru = L.outQuad((t - RISE0) / (RISE - RISE0))
				body(Vector3.new(0, -5 * (1 - ru), 0), 1 - 0.75 * c01((t - RISE0) / 0.3), C2:Lerp(W, ru))
			end
			if not risen and t >= RISE then
				risen = true
				appear(C2, hideTok)
				S:shake(1.4, 0.3)
				L.groundWave(o, "runering.png", C2, 4, 16, 0.6, 2.2)
			end
		end, objs)
		task.delay(DUR + 0.1, function() setHidden(false, hideTok) end)
	end

	local cur = 1
	local function arrive(short)
		if short then return shorts[cur]() end
		return arriveFull()
	end


	local travel, age, side = 0, 0, 1
	local lastPos
	local function step(dt)
		age += dt
		local iw, on, sprint = ch.iw, ch.on, ch.sprint
		rig.main.Enabled = on
		rig.main.Lifetime = 0.3 + 0.35 * c01(ch.spd / 30)
		rig.glyphs.Rate = on and (6 + 14 * sprint) or 0
		rig.motes.Rate = on and (12 + 30 * sprint) or 0
		if ch.dashStart then

			local p, m, set = circle("runering.png", C2, 2.4)
			local o = ch.feet
			L.fx(0.45, function(k) set(o + Vector3.new(0, 0.1, 0), 3 + 6 * L.outQuad(k), k * 5, math.max(0.06, k)) end, { p })
			burstP.CFrame = CFrame.new(ch.pos) burst:Emit(20) burstG:Emit(6)
			local g = L.ghost(C1, Enum.Material.Neon, 0.3)
		end
		if on then
			if lastPos then travel += (Vector3.new(ch.pos.X, 0, ch.pos.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude end
			if travel >= (sprint > 0.3 and 5 or 7) then
				travel = 0 side = -side

				local fp = ch.feet + ch.hrp.CFrame.RightVector * 0.5 * side
				local p, m, set = circle(sprint > 0.3 and "mcircle.png" or "runering.png", sprint > 0.3 and C1 or C2, 2.2)
				local rot = rnd(0, 6)
				L.fx(1.6, function(k)
					set(fp + Vector3.new(0, 0.07, 0), 1.6 + 1.2 * L.outQuad(c01(k / 0.12)), rot + k * 1.5, math.max(0.06, 0.15 + 0.85 * c01((k - 0.35) / 0.65)))
				end, { p })
			end
		end
		lastPos = ch.pos

		feetP.CFrame = ch.flat
		auraMotes.Rate = 14 * iw
		auraGlyphs.Rate = 4 * iw
		gCircleSet(ch.feet + Vector3.new(0, 0.06, 0), 7.5, ch.clock * 0.12, math.max(0.06, 1 - iw * 0.75), 1.4 + 0.6 * ch.breathe)
		gRuneSet(ch.feet + Vector3.new(0, 0.08, 0), 9, -ch.clock * 0.25, math.max(0.06, 1 - iw * 0.6))
		gBackSet(CFrame.new(ch.feet + Vector3.new(0, 0.03, 0)), 8.6, math.max(0.5, 1 - iw * 0.5))
		for _, ob in ipairs(orbs) do
			local a = ch.clock * 0.5 + ob.ph
			ob.p.CFrame = CFrame.new(ch.pos + Vector3.new(math.cos(a) * ob.r, ob.h + 0.2 * math.sin(ch.clock * 1.3 + ob.ph), math.sin(a) * ob.r))
			ob.img.ImageTransparency = 1 - iw * (0.7 + 0.3 * math.sin(ch.clock * 2 + ob.ph * 2))
			ob.img.ImageColor3 = C2:Lerp(W, 0.3 + 0.3 * math.sin(ch.clock * 3 + ob.ph))
			ob.mo.Rate = 4 * iw
		end
		local tw = 0.9 + 0.1 * math.sin(ch.clock * 5)
		light.Brightness = math.max(on and (1 + sprint) * tw or iw * 1.5 * tw, light.Brightness - dt * 8)
		hl.OutlineTransparency = 0.75 - 0.4 * iw

		local hp = ch.head.Position + Vector3.new(0, 1.15 + 0.08 * math.sin(ch.clock * 1.6), 0)
		local a = 0.6 + 0.4 * iw
		local tilt = CFrame.Angles(math.rad(8) * math.sin(ch.clock * 0.7), 0, math.rad(6) * math.cos(ch.clock * 0.9))
		halo.CFrame = CFrame.new(hp) * tilt * CFrame.Angles(0, ch.clock * 0.6, 0)
		halo.Transparency = math.max(0.06, 1 - a * 0.85)
		haloIn.CFrame = CFrame.new(hp + Vector3.new(0, 0.02, 0)) * tilt * CFrame.Angles(0, -ch.clock * 1.1, 0)
		haloIn.Transparency = math.max(0.06, 1 - a * 0.7)
		capTint(haloM, C2:Lerp(W, 0.3 * ch.breathe), 2.4)
		haloP.CFrame = CFrame.new(hp)
		haloDrip.Rate = 3 * a
		haloLight.Brightness = 1 + 1.2 * a

		tag.step(dt)
	end
	return { backing = false, arrive = arrive, step = step, rebind = rebind, short = function(n) cur = n shorts[n]() end,
		hidden = function() return hideOwner ~= dashTok and savedLTM or nil end, rig = function() return rig end, stop = function() tag.bb:Destroy() setHidden(false) end }
end


System.StaffThemes.THEMES.frost = function(L, C)
	local C1, C2, W = C.c1, C.c2, L.W
	local NS, CS, NR, K, CK = L.NS, L.CS, L.NR, L.K, L.CK
	local ch = L.ch
	local rnd, c01 = L.rnd, L.c01
	local DEEP = C1:Lerp(Color3.fromRGB(10, 30, 70), 0.55)

	local function snowE(parent, props)
		local p = { Texture = L.T("snow.png"), Color = CS(W, C2), LightEmission = 0.4, Brightness = 2,
			Size = NS({ K(0, 0.25), K(1, 0.15) }), Transparency = NS({ K(0, 1), K(0.15, 0), K(0.8, 0.2), K(1, 1) }),
			Lifetime = NR(2, 3), Speed = NR(1, 2), Rotation = NR(0, 360), RotSpeed = NR(-90, 90), SpreadAngle = Vector2.new(30, 30),
			Acceleration = Vector3.new(0, -2, 0), Drag = 0.6 }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function mistE(parent, props)
		local p = { Texture = L.T("smoke.png"), Color = CS(W, C2), LightEmission = 0.25, Brightness = 1.4,
			Transparency = NS({ K(0, 1), K(0.3, 0.7), K(1, 1) }), Size = NS({ K(0, 1.5), K(1, 4) }), Lifetime = NR(1.5, 2.5),
			Speed = NR(0.5, 1.5), RotSpeed = NR(-20, 20), Rotation = NR(0, 360), Acceleration = Vector3.new(0, 0.2, 0) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function glintE(parent, props)
		local p = { Texture = L.T("star.png"), Color = CS(W, C2), LightEmission = 1, Brightness = 4,
			Size = NS({ K(0, 0), K(0.5, 0.35), K(1, 0) }), Lifetime = NR(0.3, 0.6), Speed = NR(0, 0.2), Rotation = NR(0, 90) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end

	local function crystal(base, w, lean, col)
		local p, m = L.mesh("shard.mesh", nil, col or C1, 1.5, Vector3.new(w, 0.01, w))
		p.Material = Enum.Material.Glass
		p.Transparency = 1
		local root = CFrame.new(base) * lean
		local function set(h, tr, gain)
			h = math.max(h, 0.01)
			m.Scale = Vector3.new(w, h, w)
			p.CFrame = root * CFrame.new(0, h / 2, 0)
			p.Transparency = tr
			if gain then L.tint(m, col or C1, gain) end
		end
		return p, m, set, root
	end
	local function leanOut(dir, ang)

		local axis = Vector3.yAxis:Cross(dir)
		if axis.Magnitude < 0.01 then return CFrame.Angles(0, rnd(0, 6), 0) end
		return CFrame.fromAxisAngle(axis.Unit, ang) * CFrame.Angles(0, rnd(0, 6), 0)
	end

	local function shatterBits(pos, n, spd, s)
		for i = 1, n do
			local p, m = L.mesh("shard.mesh", nil, i % 3 == 0 and W or C1, 1.8, Vector3.new(0.35, 0.9, 0.35) * rnd(0.6, 1.5) * s)
			p.Material = Enum.Material.Glass
			p.Transparency = 0.15
			local v = Vector3.new(rnd(-1, 1), rnd(0.2, 1.1), rnd(-1, 1)).Unit * rnd(0.5, 1) * spd
			local p0 = pos + Vector3.new(rnd(-1, 1), rnd(0, 2), rnd(-1, 1)) * s
			local spin = CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6))
			local sx, sy = rnd(-8, 8), rnd(-8, 8)
			local floor = ch.feet.Y + 0.2
			p.CFrame = CFrame.new(p0)
			L.fx(rnd(1.1, 1.6), function(k, t)
				local pp = p0 + v * t + Vector3.new(0, -40 * t * t, 0)
				if pp.Y < floor then pp = Vector3.new(pp.X, floor, pp.Z) end
				p.CFrame = CFrame.new(pp) * spin * CFrame.Angles(t * sx, t * sy, 0)
				p.Transparency = 0.15 + 0.85 * c01((k - 0.6) / 0.4)
			end, { p })
		end
	end


	local feetP = L.part({ Size = Vector3.new(6, 0.2, 6) })
	local skyP = L.part({ Size = Vector3.new(12, 0.2, 12) })
	local burstP = L.part({ Size = Vector3.one * 2 })
	local auraSnow = snowE(skyP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Bottom, Speed = NR(1.5, 2.5),
		Lifetime = NR(2.5, 3.2), Acceleration = Vector3.new(0.6, -0.8, 0) })
	local auraMist = mistE(feetP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top, Speed = NR(0.3, 0.8),
		Size = NS({ K(0, 1.5), K(1, 3.5) }), Acceleration = Vector3.new(0, -0.1, 0) })
	local auraGlint = glintE(feetP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top })
	local burst = snowE(burstP, { Shape = Enum.ParticleEmitterShape.Sphere, Speed = NR(10, 22), Lifetime = NR(0.7, 1.1), Drag = 3,
		Size = NS({ K(0, 0.4), K(1, 0.1) }), Acceleration = Vector3.new(0, -3, 0), SpreadAngle = Vector2.new(180, 180) })
	local gFrost, gFrostM = L.mesh("disc.mesh", "cracks_b.png", C2, 1.5, Vector3.new(10, 1, 10))
	local gHex, gHexM = L.mesh("disc.mesh", "hex.png", C1, 1.2, Vector3.new(7, 1, 7))
	local gRing, gRingM = L.mesh("disc.mesh", "ring_c.png", C1, 2, Vector3.new(6, 1, 6))

	local orbs = {}
