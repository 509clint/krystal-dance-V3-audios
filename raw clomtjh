	local function stormCloud(top, size)
		local cloud, cloudM = L.mesh("swirl.mesh", "smoke.png", DARK, 1)
		local low, lowM = L.mesh("swirl.mesh", "smoke.png", DARK, 1)
		local sheet, sheetM = L.mesh("disc.mesh", "smoke.png", DARK, 1)
		local cp = L.part({ CFrame = CFrame.new(top) })
		local cl = L.new("PointLight", { Color = W, Range = size * 1.2, Brightness = 0, Shadows = false }, cp)
		local function update(t, dt, grow, fade, spin)

			local P, k = L.skyProj(top, 230)
			cloudM.Scale = Vector3.new(size * grow, size * 0.26, size * grow) * k
			cloud.CFrame = CFrame.new(P) * CFrame.Angles(0, -t * spin, 0)
			cloud.Transparency = 0.1 + 0.9 * math.max(1 - c01(t / 0.6), fade)
			lowM.Scale = Vector3.new(size * 0.6 * grow, size * 0.18, size * 0.6 * grow) * k
			low.CFrame = CFrame.new(P - Vector3.new(0, size * 0.09 * k, 0)) * CFrame.Angles(0, -t * spin * 1.4, 0)
			low.Transparency = 0.15 + 0.85 * math.max(1 - c01(t / 0.7), fade)
			sheetM.Scale = Vector3.new(size * 7 * grow * k, 1, size * 7 * grow * k)
			sheet.CFrame = CFrame.new(P + Vector3.new(0, size * 0.12 * k, 0)) * CFrame.Angles(0, -t * 0.4, 0)
			sheet.Transparency = 0.15 + 0.85 * math.max(1 - c01(t / 0.8), fade)
			cl.Brightness = math.max(0, cl.Brightness - dt * 45)
			local lit = c01(cl.Brightness / 10)
			L.tint(cloudM, DARK:Lerp(C1, lit * 0.45), 1 + lit * 0.5)
			L.tint(lowM, DARK:Lerp(C1, lit * 0.5), 1 + lit * 0.6)
			L.tint(sheetM, DARK:Lerp(C2, lit * 0.35), 0.8 + lit * 0.4)
		end
		local function darken() cl.Brightness = 0 L.tint(cloudM, DARK, 0.5) L.tint(lowM, DARK, 0.5) L.tint(sheetM, DARK, 0.4) end
		return { cloud, low, sheet, cp }, update, function(b) cl.Brightness = math.max(cl.Brightness, b) end, darken
	end
