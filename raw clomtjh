					for _, c in ipairs(m15:GetChildren()) do if c ~= h15 and c ~= hum then c:Destroy() end end
					for _, j in ipairs(h15:GetDescendants()) do if j:IsA("JointInstance") or j:IsA("Constraint") or j:IsA("WrapTarget") or j:IsA("Attachment") then j:Destroy() end end
