		gCrack.CFrame = ch.flat * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, ch.clock * 0.3, 0)
		local flick = (math.random() < 0.08) and 0.5 or 1
		gCrack.Transparency = 1 - iw * 0.65 * flick
		gRing.CFrame = ch.flat * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, -ch.clock * 1.4, 0)
		gRing.Transparency = 1 - iw * (0.5 + 0.3 * ch.breathe)
		for _, ob in ipairs(orbs) do
			local a = ch.clock * ob.sp + ob.ph
			local jit = Vector3.new(rnd(-1, 1), rnd(-1, 1), rnd(-1, 1)) * 0.12
			ob.p.CFrame = CFrame.new(ch.pos) * ob.tilt * CFrame.new(math.cos(a) * ob.r, 0, math.sin(a) * ob.r) + jit
			ob.tr.Enabled = iw > 0.1
			ob.fl.Rate = iw > 0.1 and 80 or 0
		end
		if iw > 0.6 then
			auraArcT -= dt
			if auraArcT <= 0 then auraArcT = rnd(0.06, 0.2) zap(bodyPt(rnd(1.4, 2)), bodyPt(rnd(1.4, 2.2)), 0.2, 0.1) end
			strikeT += dt
			if strikeT >= 3.2 then
				strikeT = 0
				local gp = ch.feet + Vector3.new(rnd(-2.5, 2.5), 0, rnd(-2.5, 2.5))
				L.strike(gp + Vector3.new(rnd(-4, 4), 24, rnd(-4, 4)), gp, { w = 0.6, life = 0.3, col = W, glow = C1, segs = 14, jit = 2.5, forks = 2 })
				L.groundWave(gp, "ring_c.png", C1, 2, 14, 0.6)
				burst:Emit(20)
				light.Brightness = 6
			end
		else
			strikeT = 1.5
		end
		light.Brightness = math.max(on and (0.5 + 1.5 * sprint) or iw * (0.8 + 0.8 * ((math.random() < 0.15) and 1 or 0)), light.Brightness - dt * 12)
		hl.OutlineTransparency = (math.random() < 0.06) and 0.9 or (0.7 - 0.5 * iw)

		local hp = ch.head.Position + Vector3.new(0, 1.2 + 0.08 * math.sin(ch.clock * 1.6), 0)
		local a = 0.55 + 0.45 * iw
		halo.CFrame = CFrame.new(hp) * CFrame.Angles(0, ch.clock * 1.5, 0)
		haloM.Scale = Vector3.new(2.8 + 0.1 * ch.breathe, 1, 2.8 + 0.1 * ch.breathe)
		halo.Transparency = 1 - a * 0.95
		halo2.CFrame = CFrame.new(hp + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, -ch.clock * 2.5, 0)
		halo2.Transparency = 1 - a * ((math.random() < 0.1) and 0.3 or 0.8)
		haloT -= dt
		if haloT <= 0 then
			haloT = on and 0.12 or 0.05
			local a0 = rnd(0, 6.28)
			local a1 = a0 + rnd(0.6, 1.4)
			local r = 1.4
			L.bolt(hp + Vector3.new(math.cos(a0) * r, 0, math.sin(a0) * r), hp + Vector3.new(math.cos(a1) * r, rnd(-0.1, 0.5), math.sin(a1) * r),
				{ w = 0.12, life = 0.08, col = W, glow = C2, segs = 4, jit = 0.25 })
		end

		tag.step(dt)
	end
	return { arrive = arrive, step = step, rebind = rebind, short = function(n) cur = n shorts[n]() end, hidden = function() return hideOwner ~= dashTok and savedLTM or nil end, rig = function() return rig end, stop = function() tag.bb:Destroy() setHidden(false) end }
end


System.StaffThemes.THEMES.mage = function(L, C)
	local C1, C2, W = C.c1, C.c2, L.W
	local NS, CS, NR, K, CK = L.NS, L.CS, L.NR, L.K, L.CK
	local ch = L.ch
	local rnd, c01 = L.rnd, L.c01
	local DEEP = C1:Lerp(Color3.fromRGB(10, 15, 50), 0.6)

	local function moteE(parent, props)
		local p = { Texture = L.T("spark.png"), Color = CS(W, C2), LightEmission = 1, Brightness = 4,
			Size = NS({ K(0, 0), K(0.2, 0.22), K(1, 0) }), Transparency = NS({ K(0, 1), K(0.2, 0), K(1, 1) }),
			Lifetime = NR(1.2, 2), Speed = NR(0.5, 1.5), Acceleration = Vector3.new(0, 1.2, 0), Drag = 0.5 }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function glyphE(parent, props)
		local p = { Texture = L.T("glyphs2.png"), FlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4, FlipbookMode = Enum.ParticleFlipbookMode.Random,
			FlipbookFramerate = NR(2, 4), Color = CS(C2, C1), LightEmission = 1, Brightness = 3,
			Size = NS({ K(0, 0), K(0.15, 0.6), K(0.8, 0.5), K(1, 0) }), Transparency = NS({ K(0, 1), K(0.15, 0), K(0.75, 0.2), K(1, 1) }),
			Lifetime = NR(1, 1.6), Speed = NR(0.5, 1.5), Acceleration = Vector3.new(0, 1, 0), Drag = 0.8 }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function flareE(parent, props)
		local p = { Texture = L.T("flare.png"), Color = CS(W, C2), LightEmission = 1, Brightness = 5, Speed = NR(0), Lifetime = NR(0.4),
			Size = NS({ K(0, 2), K(0.15, 9), K(1, 0) }), Transparency = NS({ K(0, 0), K(1, 1) }), LockedToPart = true }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end

	local GCAP = 1.3
	local BACK = Color3.fromRGB(5, 7, 20)
	local function capTint(m, col, g, hot)
		if hot and hot > 0 then col = col:Lerp(W, c01(hot)) end
		L.tint(m, col, math.min(g or 1.2, GCAP / math.max(col.R, col.G, col.B, 0.05)))
	end
	local function mmesh(mesh, tex, col, gain, scale)
		local p, m = L.mesh(mesh, tex, col, gain, scale)
		capTint(m, col, gain)
		return p, m
	end

	local function circle(tex, col, gain)
		local p, m = mmesh("disc.mesh", tex, col, gain or 2)
		p.Transparency = 1
		local function set(pos, size, rot, tr, g, c, hot, flip)
			m.Scale = Vector3.new(size, 1, size)
			p.CFrame = CFrame.new(pos) * (flip and CFrame.Angles(math.pi, 0, 0) or CFrame.identity) * CFrame.Angles(0, rot, 0)
			p.Transparency = tr
			if g or c or hot then capTint(m, c or col, g or gain or 2, hot) end
		end
		return p, m, set
	end
	local function orient(pos, dir) return CFrame.lookAt(pos, pos + dir) * CFrame.Angles(math.rad(90), 0, 0) end

	local function vcircle(tex, col, gain)
		local p, m = mmesh("disc.mesh", tex, col, gain or 2)
		p.Transparency = 1
		local function set(pos, dir, size, rot, tr, hot)
			m.Scale = Vector3.new(size, 1, size)
			p.CFrame = orient(pos, dir) * CFrame.Angles(0, rot, 0)
			p.Transparency = tr
			if hot then capTint(m, col, gain or 2, hot) end
		end
		return p, m, set
	end

	local function backing()
		local p, m = L.mesh("disc.mesh", "darkdisc.png", BACK, 1)
		p.Transparency = 1
		return p, function(cf, size, tr)
			m.Scale = Vector3.new(size, 1, size)
			p.CFrame = cf
			p.Transparency = tr
		end
	end
	local function camBasis() return L.facing() end

	local function shards(pos, n, spd, s, col)
		for i = 1, n do
			local p = mmesh("shard.mesh", nil, i % 3 == 0 and W or col, 1.3, Vector3.new(0.3, 0.8, 0.3) * rnd(0.6, 1.4) * s)
			p.Material = Enum.Material.Glass
			p.Transparency = 0.2
			local v = Vector3.new(rnd(-1, 1), rnd(0.2, 1.1), rnd(-1, 1)).Unit * rnd(0.5, 1) * spd
			local spin = CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6))
			local sx, sy = rnd(-8, 8), rnd(-8, 8)
			local floor = ch.feet.Y + 0.2
			p.CFrame = CFrame.new(pos)
			L.fx(rnd(1, 1.5), function(k, t)
				local pp = pos + v * t + Vector3.new(0, -40 * t * t, 0)
				if pp.Y < floor then pp = Vector3.new(pp.X, floor, pp.Z) end
				p.CFrame = CFrame.new(pp) * spin * CFrame.Angles(t * sx, t * sy, 0)
				p.Transparency = 0.2 + 0.8 * c01((k - 0.6) / 0.4)
			end, { p })
		end
	end


	local feetP = L.part({ Size = Vector3.new(7, 0.2, 7) })
	local burstP = L.part({ Size = Vector3.one * 2 })
	local auraMotes = moteE(feetP, { Shape = Enum.ParticleEmitterShape.Disc, EmissionDirection = Enum.NormalId.Top })
	local auraGlyphs = glyphE(feetP, { Shape = Enum.ParticleEmitterShape.Disc, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface, EmissionDirection = Enum.NormalId.Top,
		Speed = NR(0.8, 1.4), Lifetime = NR(1.4, 2), Size = NS({ K(0, 0), K(0.15, 0.45), K(0.8, 0.35), K(1, 0) }) })
	local burst = moteE(burstP, { Shape = Enum.ParticleEmitterShape.Sphere, Speed = NR(10, 24), Lifetime = NR(0.5, 0.9), Drag = 4, Acceleration = Vector3.zero,
		Size = NS({ K(0, 0.35), K(1, 0) }), SpreadAngle = Vector2.new(180, 180), Transparency = NS({ K(0, 0), K(1, 1) }) })
	local burstG = glyphE(burstP, { Shape = Enum.ParticleEmitterShape.Sphere, Speed = NR(6, 14), Drag = 3, Lifetime = NR(0.8, 1.3), Acceleration = Vector3.new(0, -2, 0) })
	local gCircle, gCircleM, gCircleSet = circle("mcircle.png", C1, 1.6)
	local gRune, gRuneM, gRuneSet = circle("runering.png", C2, 1.8)
	local gBack, gBackSet = backing()

	local orbs = {}
	for i = 1, 4 do
		local p = L.part({ Size = Vector3.one * 0.2 })
		local bb = L.new("BillboardGui", { Size = UDim2.fromScale(1.15, 1.15), LightInfluence = 0, AlwaysOnTop = false, Adornee = p, MaxDistance = 150 }, p)
		local cell = (i * 5) % 16
		local img = L.new("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Image = L.T("glyphs2.png"),
			ImageRectOffset = Vector2.new((cell % 4) * 128, math.floor(cell / 4) * 128), ImageRectSize = Vector2.new(128, 128), ImageColor3 = C2 }, bb)
		local mo = moteE(p, { Rate = 0, Speed = NR(0.2, 0.5), Lifetime = NR(0.6, 1), Size = NS({ K(0, 0.15), K(1, 0) }), Acceleration = Vector3.zero })
		orbs[i] = { p = p, img = img, bb = bb, mo = mo, ph = i / 4 * math.pi * 2, r = 2.6 + (i % 2) * 0.4, h = 0.4 + (i % 2) * 0.7 }
	end

	local halo, haloM = mmesh("disc.mesh", "runering.png", C2, 2.4, Vector3.new(2.6, 1, 2.6))
	local haloIn, haloInM = mmesh("disc.mesh", "mcircle.png", C1, 2.2, Vector3.new(1.5, 1, 1.5))
	local haloP = L.part({ Size = Vector3.new(2, 0.2, 2) })
	local haloDrip = glyphE(haloP, { Shape = Enum.ParticleEmitterShape.Disc, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface, EmissionDirection = Enum.NormalId.Bottom,
		Rate = 3, Speed = NR(0.3, 0.6), Acceleration = Vector3.new(0, -0.6, 0), Lifetime = NR(1, 1.4), Size = NS({ K(0, 0), K(0.2, 0.28), K(1, 0) }) })
	local haloLight = L.new("PointLight", { Color = C1, Range = 10, Brightness = 1.5, Shadows = false }, haloP)

	local rig, light, hl = {}, nil, nil
	local function rebind()
		for _, o in ipairs(rig) do o:Destroy() end
		rig = {}
		local hrp = ch.hrp
		local function att(pos) local a = L.new("Attachment", { Position = pos }, hrp) rig[#rig + 1] = a return a end
		local function trail(a0, a1, props) local t = L.new("Trail", props, hrp) t.Attachment0, t.Attachment1 = a0, a1 rig[#rig + 1] = t return t end
		rig.main = trail(att(Vector3.new(0, 1.1, 0.3)), att(Vector3.new(0, -1.4, 0.3)), { Texture = L.T("beamb.png"), LightEmission = 1, Brightness = 3,
			Lifetime = 0.35, FaceCamera = true, Enabled = false, Color = CS({ CK(0, W), CK(0.3, C2), CK(1, C1) }),
			Transparency = NS({ K(0, 0.25), K(1, 1) }), WidthScale = NS({ K(0, 1), K(1, 0.2) }) })
		local back = att(Vector3.new(0, -0.3, 0.6))
		rig.glyphs = glyphE(back, { Speed = NR(0.5, 1.5), Lifetime = NR(0.7, 1.1), EmissionDirection = Enum.NormalId.Back, SpreadAngle = Vector2.new(40, 40),
			Acceleration = Vector3.new(0, 0.6, 0) })
		rig.motes = moteE(back, { Speed = NR(1, 3), Lifetime = NR(0.5, 0.9), EmissionDirection = Enum.NormalId.Back, SpreadAngle = Vector2.new(50, 50) })
		for _, e in ipairs({ rig.glyphs, rig.motes }) do rig[#rig + 1] = e end
		light = L.new("PointLight", { Color = C1, Range = 14, Brightness = 0, Shadows = false }, hrp) rig[#rig + 1] = light
		hl = L.new("Highlight", { FillTransparency = 1, OutlineColor = C2, Adornee = ch.char, DepthMode = Enum.HighlightDepthMode.Occluded }, L.root)
		rig[#rig + 1] = hl
	end
	rebind()
	local tag = System.StaffThemes.headTag(L, "mage", C1, C2, { c1 = C1, c2 = C2, grad = CS({ CK(0, C1), CK(0.35, C2), CK(0.5, W), CK(0.65, C2), CK(1, C1) }) })


	local savedLTM, hideChar, hideOwner, hideGen, dashTok = nil, nil, nil, 0, nil
	local function setHidden(on, tok)
		if on then
			hideGen += 1
			local my = hideGen
			hideOwner = my
			task.delay(15, function() setHidden(false, my) end)
			if savedLTM and hideChar == ch.char then return my end
			if not ch.char then return my end
			savedLTM, hideChar = {}, ch.char
			for _, d in ipairs(ch.char:GetDescendants()) do
				if d:IsA("BasePart") or d:IsA("Decal") then savedLTM[d] = d.LocalTransparencyModifier d.LocalTransparencyModifier = 1 end
			end
			return my
		elseif savedLTM then
			if tok and tok ~= hideOwner then return end
			for d, v in pairs(savedLTM) do if d.Parent then d.LocalTransparencyModifier = v end end
			if tok and tok ~= dashTok then L.punch(1.1, 0.3) end
			savedLTM, hideChar, hideOwner = nil, nil, nil
		end
	end
	local function appear(col, tok)
		setHidden(false, tok)
		hl.FillColor, hl.FillTransparency = col or W, 0.15
		light.Brightness = 8
		burstP.CFrame = CFrame.new(ch.pos) burst:Emit(40) burstG:Emit(14)
		L.fx(0.9, function(k) hl.FillTransparency = 0.15 + 0.85 * k end, {})
	end

	local function summonBody(col, life)
		local g = L.ghost(col, Enum.Material.Neon, life, true)
		local start = {}
		for _, p in ipairs(g:GetChildren()) do start[p] = p.CFrame p.Transparency = 1 end
		return function(off, tr, c)
			for p, cf in pairs(start) do
				if p.Parent then p.CFrame = cf + off p.Transparency = tr if c then p.Color = c end end
			end
		end
	end






	local function arriveFull()
		local o = ch.feet
		local DUR = 11.6
		local CONST, LINES, DROP, LAND, TOWER, SIDES, LOCK, ERUPT, REVEAL, BREAK, SHRINK, SETTLE =
			0.2, 0.85, 1.85, 2.3, 2.8, 3.3, 5.3, 6.0, 7.2, 7.45, 7.9, 10.7
		local hideTok = setHidden(true)
		local S = L.screen(DUR)
		S.dimFn = function(t) return (0.4 * c01(t / 0.8) + 0.25 * c01((t - LOCK) / 0.4) * (1 - c01((t - ERUPT) / 0.3))) * (1 - c01((t - BREAK - 1) / 2)) end
		S.style, S.c1, S.c2 = "mage", C1, C2 S.boxFn = function(t) return c01((t - 0.2) / 0.6) * (1 - c01((t - (DUR - 1.2)) / 0.9)) end
		S.tintFn = function(t) return C1, 0.3 * c01(t / 1.2) * (1 - c01((t - BREAK - 0.5) / 2.5)) end
		L.after(REVEAL + 0.4, function() S:title(L.name(), C1, C2) end)
		local objs = {}
		local function own(x) objs[#objs + 1] = x return x end
		local R, SKY = 20, 30
		local RH = R * 0.8

		local stars, lines = {}, {}
		for i = 0, 6 do
			local p = own(L.part({ Size = Vector3.one * 0.3 }))
			local f = flareE(p, { Rate = 0, Lifetime = NR(0.2), LightEmission = 0.5, Color = CS(C2:Lerp(W, 0.4), C2), Size = NS({ K(0, 4), K(0.5, 6.5), K(1, 0) }) })
			stars[i] = { p = p, f = f, a = i / 7 * math.pi * 2 - math.pi / 2, t0 = CONST + i * 0.09, on = false }
		end
		for i = 0, 6 do
			local a0, a1 = own(L.att(o)), own(L.att(o))
			local b = own(L.beam(a0, a1, { Width0 = 0.7, Width1 = 0.7, Brightness = 3, LightEmission = 0.35, Color = CS(C2:Lerp(W, 0.25), C1), Transparency = NS(1) }))
			lines[i] = { a0 = a0, a1 = a1, b = b, j = (i + 3) % 7, t0 = LINES + i * 0.13 }
		end
		local function starPos(i, t)
			local u = L.inQuad((t - DROP) / (LAND - DROP))
			local h = (SKY - 4) + (0.4 - (SKY - 4)) * u
			local rr = 11 + (RH - 11) * u
			local a = stars[i].a + t * 0.15
			return o + Vector3.new(math.cos(a) * rr, h, math.sin(a) * rr)
		end

		local bk, bkSet = backing() own(bk)
		local gc, gcm, gcSet = circle("mcircle.png", C1, 1.6) own(gc)
		local gr, grm, grSet = circle("runering.png", C2, 1.8) own(gr)
		local gi, gim, giSet = circle("runering.png", C2, 2) own(gi)
		local pens = {}
		for i = 1, 2 do
			local p = own(L.part({ Size = Vector3.one * 0.3, CFrame = CFrame.new(o + Vector3.new(R, 0.3, 0)) }))
			local a0 = L.new("Attachment", { Position = Vector3.new(0, 0.25, 0) }, p)
			local a1 = L.new("Attachment", { Position = Vector3.new(0, -0.25, 0) }, p)
			local tr = L.new("Trail", { Attachment0 = a0, Attachment1 = a1, Texture = L.T("beamb.png"), LightEmission = 1, Brightness = 6, Lifetime = 0.4,
				FaceCamera = true, Enabled = false, Color = CS(W, C2), Transparency = NS(0, 1), WidthScale = NS(1, 0.4) }, p)
			local f = flareE(p, { Rate = 0, Lifetime = NR(0.12), Size = NS(3) })
			pens[i] = { p = p, tr = tr, f = f, r = ({ R * 1.0, R * 0.38 })[i], t0 = LAND + 0.05, dur = 0.6 }
		end

		local skB, skBSet = backing() own(skB)
		local sc, scm, scSet = circle("mcircle.png", C1, 1.6) own(sc)
		local sr, srm, srSet = circle("runering.png", C2, 1.8) own(sr)
		local skyP = own(L.part({ Size = Vector3.new(R * 1.6, 0.2, R * 1.6), CFrame = CFrame.new(o + Vector3.new(0, SKY, 0)) }))
		local skyG = glyphE(skyP, { Shape = Enum.ParticleEmitterShape.Disc, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface, EmissionDirection = Enum.NormalId.Bottom,
			Speed = NR(2, 4), Lifetime = NR(1.2, 1.8), Acceleration = Vector3.new(0, -2, 0), Size = NS({ K(0, 0), K(0.15, 1), K(0.8, 0.8), K(1, 0) }) })
		local skyF = flareE(skyP, { Rate = 0, Lifetime = NR(0.3), Size = NS({ K(0, 6), K(0.2, 26), K(1, 0) }) })

		local PAL = { Color3.fromRGB(255, 70, 80), Color3.fromRGB(255, 170, 40), Color3.fromRGB(70, 235, 120),
			Color3.fromRGB(60, 215, 255), Color3.fromRGB(165, 95, 255), Color3.fromRGB(255, 95, 205) }
		local casters = {}
		do
			local root = ch.hrp.CFrame
			local tmpl = {}
			local pivots = {}
			for _, p in ipairs(ch.char:GetChildren()) do
				if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 then
					local rel = root:ToObjectSpace(p.CFrame)
					local n = p.Name
					local side = (n:find("Arm") or n:find("Hand")) and (n:find("Left") and "L" or "R") or nil
					if side and (n:find("UpperArm") or n == "Left Arm" or n == "Right Arm") then
						pivots[side] = (rel * CFrame.new(0, p.Size.Y * 0.4, 0)).Position
					end
					tmpl[#tmpl + 1] = { src = p, rel = rel, side = side }
				end
			end
			local HY = root.Position.Y - o.Y
			for j = 0, 5 do
				local col = PAL[j + 1]
				local a = j / 6 * math.pi * 2 + math.pi / 6
				local spot = o + Vector3.new(math.cos(a) * (R + 6), 0, math.sin(a) * (R + 6))
				local m = own(Instance.new("Model"))
				local parts = {}
				for _, tp in ipairs(tmpl) do
					local g = tp.src:Clone()
					for _, d in ipairs(g:GetChildren()) do if not d:IsA("DataModelMesh") then d:Destroy() end end
					g.Anchored, g.CanCollide, g.CanQuery, g.CanTouch, g.CastShadow = true, false, false, false, false
					g.Material, g.Color = Enum.Material.SmoothPlastic, col:Lerp(Color3.new(0, 0, 0), 0.55)
					if g:IsA("MeshPart") then g.TextureID = "" end
					g.Transparency = 1
					g.Parent = m
					parts[#parts + 1] = { g = g, tp = tp }
				end
				m.Parent = L.root
