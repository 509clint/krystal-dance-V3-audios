					for _, al in ipairs(e.labs) do al.Size = UDim2.fromScale(0.4, h) end
				end

				if not froze and t >= BANG - 0.06 then
					froze = true
					if S then S.flashA = 0 if S.fl then S.fl.BackgroundTransparency = 1 end
						S.cc.Contrast, S.cc.Saturation, S.cc.Brightness, S.cc.TintColor = -2, 0.2, 0, W end
					L.hitStop(0.5)
				end
			end, uo)
			for i = #L.live, 1, -1 do
				if L.live[i].objs == uo then L.live[i].done = function() wsky.set(0) end break end
			end
		end
		local top = o + Vector3.new(0, short and 34 or 10, 0)
		local cp = top

		local gc, gcm = L.mesh("disc.mesh", "cracks_b.png", C1, 1.8)
		local gd, gdm = L.mesh("swirl.mesh", "smoke.png", BLACK, 1)

		local core = blackBall(0.1)
		local r1, r1m = rim(C2, 3.2)
		local r2, r2m = rim(C1, 2.6)
		local acc, accM = L.mesh("swirl.mesh", "swirl.png", C2, 2.4)
		local acc2, acc2M = L.mesh("disc.mesh", "ring_c.png", C1, 2.4)
		local inP = L.part({ Size = Vector3.one * 2, CFrame = CFrame.new(cp) })
		local inA = L.new("Attachment", {}, inP)
		local stream = suckE(inP, { LockedToPart = false, Speed = NR(22, 28), Lifetime = NR(0.55, 0.65),
			Size = NS({ K(0, 0.2), K(0.7, 0.9), K(1, 0) }), Squash = NS(-3) })
		local streamD = darkE(inP, { Shape = Enum.ParticleEmitterShape.Sphere, ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
			ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface, Speed = NR(18, 26), Lifetime = NR(0.7, 0.9), Size = NS({ K(0, 6), K(1, 1) }),
			Transparency = NS({ K(0, 1), K(0.4, 0.4), K(1, 1) }) })
		local cLight = L.new("PointLight", { Color = C2, Range = 50, Brightness = 0, Shadows = false }, inP)

		local orbit = {}
		for i = 1, short and 6 or 16 do
			local p, m = shard(i % 2 == 0 and C1 or C2, rnd(0.6, 1.4) * sc)
			orbit[i] = { p = p, m = m, a = rnd(0, 6.28), r0 = rnd(18, 30) * sc, y = rnd(-6, 6) * sc, sp = rnd(1.5, 2.5), tilt = CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6)) }
		end
		local banged = false
		local slamH, slamT = L.att(top), L.att(top)
		local slamB = L.beam(slamH, slamT, { Enabled = false, Width0 = 6, Width1 = 1, Brightness = 6, Segments = 2,
			Color = CS({ CK(0, W), CK(0.3, C2), CK(1, C1) }), Transparency = NS({ K(0, 0), K(1, 1) }) })
		local objs = { gc, gd, core, r1, r2, acc, acc2, inP, slamH, slamT, slamB }
		for _, s in ipairs(orbit) do objs[#objs + 1] = s.p end
		L.fx(DUR, function(k, t)
			local form = c01((t - FORM) / (COL - FORM))
			local col = c01((t - COL) / (BANG - COL))
			local shrink = short and 0 or col
			if short then
				cp = top:Lerp(o + Vector3.new(0, 1.5, 0), col * col)
				slamH.WorldPosition = cp
				slamT.WorldPosition = cp + Vector3.new(0, math.min((top - cp).Magnitude, 26), 0)
				slamB.Enabled = col > 0 and not banged
			end
			local after = c01((t - BANG) / 3.5)

			local gs = (banged and 40 or 6 + 22 * form) * sc
			gcm.Scale = Vector3.new(gs, 1, gs)
			gc.CFrame = CFrame.new(o + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, -t * 0.4, 0)
			L.tint(gcm, C1:Lerp(C2, banged and (1 - after) or form * 0.4), banged and 3 * (1 - after) + 0.5 or 1.2 + form)
			gc.Transparency = 1 - 0.85 * c01(t / 0.5) * (1 - c01((t - DUR + 1.2) / 1.2))
			local ds = (4 + 18 * form) * sc * (banged and (1 + after) or 1)
			gdm.Scale = Vector3.new(ds, 0.5, ds)
			gd.CFrame = CFrame.new(o + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, -t * 2, 0)
			gd.Transparency = 1 - 0.7 * c01(t / 0.6) * (1 - after)
			if not banged then
				local size = (0.2 + 4.2 * L.outQuad(form)) * (1 - shrink) * sc
				core.Size = Vector3.one * math.max(size, 0.05)
				core.CFrame = CFrame.new(cp)
				core.Transparency = t < FORM and 1 or 0
				local rs = size * 2.6 + 0.5 * math.sin(t * 20) * form
				r1m.Scale = Vector3.new(rs, 1, rs)
				r1.CFrame = faceCam(cp)
				r1.Transparency = 1 - 0.95 * form
				local rs2 = rs * 1.35
				r2m.Scale = Vector3.new(rs2, 1, rs2)
				r2.CFrame = faceCam(cp) * CFrame.Angles(0, -t * 3, 0)
				r2.Transparency = 1 - 0.7 * form
				local as = (2 + 20 * L.outQuad(form)) * sc * (1 - shrink)
				accM.Scale = Vector3.new(as, as * 0.08, as)
				acc.CFrame = CFrame.new(cp) * CFrame.Angles(math.rad(18), -t * (3 + 6 * form), 0)
				acc.Transparency = 1 - 0.9 * form
				acc2M.Scale = Vector3.new(as * 1.4, 1, as * 1.4)
				acc2.CFrame = CFrame.new(cp) * CFrame.Angles(math.rad(18), -t * 2, 0)
				acc2.Transparency = 1 - 0.8 * form
				inP.Size = Vector3.one * (30 * sc) * (1 - 0.5 * shrink)
				inP.CFrame = CFrame.new(cp)
				stream.Rate = form > 0 and (short and 120 or 380) * (1 - col) or 0
				streamD.Rate = form > 0 and (short and 15 or 40) * (1 - col) or 0
				cLight.Brightness = 2 + 6 * form
				for _, s in ipairs(orbit) do
					local r = s.r0 * (1 - L.outQuad(form) * 0.85) * (1 - shrink)
					s.a += 0.016 * s.sp * (1 + 6 * form)
					s.p.CFrame = CFrame.new(cp + Vector3.new(math.cos(s.a) * r, s.y * (1 - form), math.sin(s.a) * r)) * s.tilt * CFrame.Angles(t * 2, t, 0)
					s.p.Transparency = t < FORM and 1 or 0
					L.tint(s.m, C1:Lerp(C2, form), 1 + 2 * form)
				end
				if S then S:shake(0.15 + 0.9 * form * form, 0.2) end

				if form > 0.2 and math.random() < 0.08 * form then
					local a = rnd(0, 6.28)
					L.bolt(cp + Vector3.new(math.cos(a), rnd(-0.4, 0.4), math.sin(a)) * rnd(10, 18) * sc, cp,
						{ col = C2, w = 0.25, life = 0.15, segs = 6, glow = C1 })
				end
				if t >= BANG then
					banged = true
					core.Transparency, r1.Transparency, r2.Transparency, acc.Transparency, acc2.Transparency = 1, 1, 1, 1, 1
					stream.Rate, streamD.Rate, cLight.Brightness = 0, 0, 0
					slamB.Enabled = false
					for _, s in ipairs(orbit) do s.p.Transparency = 1 end

					if S then S:flash(C2:Lerp(W, 0.55), 0.85) S:shake(3.2, 1.4) end
					local fb = L.part({ Transparency = 0, Material = Enum.Material.Neon, Color = W, CFrame = CFrame.new(cp) })
					local fbm = L.new("SpecialMesh", { MeshType = Enum.MeshType.Sphere }, fb)
					L.fx(0.5, function(kk) local s = (1 + 26 * L.outQuad(kk)) * sc * 10 fbm.Scale = Vector3.one * s
						fb.Color = W:Lerp(C1, kk) fb.Transparency = c01(kk * 1.4 - 0.1) end, { fb })

					local sh, shm = L.mesh("sphere.mesh", "smoke.png", BLACK, 1)
					L.fx(1.2, function(kk) local s = (4 + 36 * L.outQuad(kk)) * sc shm.Scale = Vector3.new(s, s * 0.8, s) sh.CFrame = CFrame.new(cp) * CFrame.Angles(0, -kk * 3, 0)
						sh.Transparency = 0.2 + 0.8 * kk end, { sh })

					local ra, rb = L.att(o + Vector3.new(0, 140 * sc, 0)), L.att(o)
					local rift = L.beam(ra, rb, { Width0 = 3 * sc, Width1 = 7 * sc, Brightness = 8, Segments = 2, Color = CS({ CK(0, C1), CK(0.5, C2), CK(1, W) }) })
					local riftD = L.beam(ra, rb, { Width0 = 9 * sc, Width1 = 16 * sc, Brightness = 1, LightEmission = 0, Segments = 2, Color = CS(BLACK) })
					L.fx(1.4, function(kk)
						rift.Transparency = NS(c01(kk * 1.2)) rift.Width1 = 7 * sc * (1 - kk * 0.8)
						riftD.Transparency = NS(0.3 + 0.7 * kk)
					end, { ra, rb, rift, riftD })
					L.groundWave(o, "ring_c.png", W, 4, 70 * sc, 0.6)
					L.groundWave(o, "ring_c.png", C2, 4, 46 * sc, 0.9)
					L.groundWave(o, "ring_c.png", C1, 4, 30 * sc, 1.2)
					L.groundWave(o, "cracks_b.png", C1, 6, 44 * sc, 1.6, 2.4)
					if not short then L.groundWave(o, "ring_c.png", C1, 10, 1400, 5.4, 2.6) end
					burst:Emit(short and 30 or 90)

					for _, s in ipairs(orbit) do
						local d = Vector3.new(rnd(-1, 1), rnd(-0.3, 0.8), rnd(-1, 1)).Unit * rnd(16, 32) * sc
						local p0 = cp
						s.p.Transparency = 0
						local spin = CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6))
						L.fx(2.6, function(kk, tt)
							local out = L.outQuad(c01(tt / 0.5))
							local back = c01((tt - 1.6) / 0.9)
							local pos = (p0 + d * out):Lerp(ch.pos, back * back)
							s.p.CFrame = CFrame.new(pos) * spin * CFrame.Angles(tt * 4, tt * 3, 0)
							L.tint(s.m, C2:Lerp(C1, kk), 2.5 - 1.5 * kk)
							s.p.Transparency = back > 0.95 and 1 or 0
							if back > 0.97 and not s.fin then s.fin = true burst:Emit(4) end
						end, {})
					end

					local ringObjs = {}
					for j = 1, 16 do
						local a = j / 16 * math.pi * 2
						local p0 = o + Vector3.new(math.cos(a) * 2, 0.8, math.sin(a) * 2)
						local rp = L.part({ Size = Vector3.new(1.5, 1, 0.2), CFrame = CFrame.lookAt(p0, p0 + Vector3.new(math.cos(a), 0, math.sin(a))) })
						local de = darkE(rp, { EmissionDirection = Enum.NormalId.Front, Speed = NR(30, 50), Drag = 2.5, Lifetime = NR(1, 1.6),
							SpreadAngle = Vector2.new(10, 6), Size = NS({ K(0, 3 * sc), K(1, 7 * sc) }) })
						de:Emit(short and 2 or 4)
						ringObjs[#ringObjs + 1] = rp
					end
					L.fx(2, function() end, ringObjs)
					light.Brightness = 8
				end
			else

				gd.Transparency = 1 - 0.7 * (1 - after)
			end
		end, objs)

		L.after(BANG, function()
			if short then return end
			local mp = L.part({ Size = Vector3.new(30, 0.2, 30), CFrame = CFrame.new(o) })
			local me = suckE(mp, { Shape = Enum.ParticleEmitterShape.Box, ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward,
				EmissionDirection = Enum.NormalId.Top, Speed = NR(1, 3), Lifetime = NR(2, 3), Acceleration = Vector3.new(0, 2, 0),
				Orientation = Enum.ParticleOrientation.FacingCamera, Squash = NS(0), LockedToPart = false, Size = NS({ K(0, 0.3), K(1, 0) }) })
			L.fx(3.5, function(kk) me.Rate = 60 * (1 - kk) end, { mp })
		end)
	end


	local travel, ghostT, boomT, pulseT, age, side = 0, 0, 0, 0, 0, 1
	local lastPos
	local function step(dt)
		age += dt
		local iw, on, sprint = ch.iw, ch.on, ch.sprint
		rig.main.Enabled, rig.edge.Enabled, rig.edge2.Enabled = on, on, on
		local life = 0.3 + 0.4 * c01(ch.spd / 30)
		rig.main.Lifetime, rig.edge.Lifetime, rig.edge2.Lifetime = life, life, life
		rig.dark.Rate = on and (8 + 20 * sprint) or 0
		if ch.dashStart then

			local p0 = ch.feet
			implode(p0, C2, 16, 0.5, 0.35, 3)
			L.after(0.35, function() L.groundWave(p0, "ring_c.png", C1, 1, 12, 0.4) end)
			burst:Emit(30)
		end
		if on then
			local dir = ch.spd > 0.1 and ch.vel.Unit or Vector3.zAxis
			if lastPos then travel += (Vector3.new(ch.pos.X, 0, ch.pos.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude end
			if travel >= 4 then
				travel = 0 side = -side

				local fp = ch.feet + ch.hrp.CFrame.RightVector * 0.6 * side
				local p, m = L.mesh("disc.mesh", "cracks_b.png", C1, 2.2, Vector3.new(2.6, 1, 2.6))
				local d, dm = L.mesh("disc.mesh", "ring_c.png", BLACK, 1, Vector3.new(1.4, 1, 1.4))
				local rot = rnd(0, 6)
				L.fx(1.1, function(k)
					p.CFrame = CFrame.new(fp + Vector3.new(0, 0.06, 0)) * CFrame.Angles(0, rot + k * 2, 0)
					local s = 2.6 * (1 - 0.7 * k * k)
					m.Scale = Vector3.new(s, 1, s)
					L.tint(m, C2:Lerp(C1, k), 2.2 * (1 - k) + 0.6)
					p.Transparency = 0.1 + 0.9 * c01((k - 0.4) / 0.6)
					d.CFrame = CFrame.new(fp + Vector3.new(0, 0.08, 0))
					dm.Scale = Vector3.new(1.6 * (1 - k), 1, 1.6 * (1 - k))
					d.Transparency = 0.2 + 0.8 * k
				end, { p, d })
			end
			ghostT += dt
			if ch.spd > 10 and ghostT >= 0.15 - 0.06 * sprint then
				ghostT = 0

				local g = L.ghost(BLACK, Enum.Material.SmoothPlastic, 0.35)
				local gh = L.new("Highlight", { FillTransparency = 1, OutlineColor = C2, OutlineTransparency = 0.2, Adornee = g, DepthMode = Enum.HighlightDepthMode.Occluded }, L.root)
				L.fx(0.35, function(k) gh.OutlineTransparency = 0.2 + 0.8 * k gh.OutlineColor = C2:Lerp(C1, k) end, { gh })
			end
			boomT += dt
			if sprint > 0.2 and boomT >= 0.45 then
				boomT = 0

				local bp = ch.pos - dir * 2
				local p, m = L.mesh("disc.mesh", "ring_c.png", C2, 2.6)
				local cf = CFrame.lookAt(bp, bp + dir) * CFrame.Angles(math.rad(90), 0, 0)
				L.fx(0.35, function(k) local s = 10 - 9 * k * k m.Scale = Vector3.new(s, 1, s) p.CFrame = cf - dir * (k * 2)
					L.tint(m, C1:Lerp(C2, k), 2.6) p.Transparency = 1 - 0.95 * c01(k / 0.3) * (1 - c01((k - 0.8) / 0.2)) end, { p })
			end
		end
		lastPos = ch.pos

		feetP.CFrame = ch.flat
		suckP.CFrame = CFrame.new(ch.pos)
		burstP.CFrame = CFrame.new(ch.pos)
		auraSuck.Rate = 70 * iw + (on and (20 + 60 * sprint) or 0)
		auraDark.Rate = 12 * iw
		gDisc.CFrame = ch.flat * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, -ch.clock * 1.4, 0)
		gDiscM.Scale = Vector3.new(8 + 0.6 * ch.breathe, 0.3, 8 + 0.6 * ch.breathe)
		gDisc.Transparency = 1 - iw * 0.6
		gCrack.CFrame = ch.flat * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, -ch.clock * 0.2, 0)
		L.tint(gCrackM, C1:Lerp(C2, 0.4 * ch.breathe), 1.4 + 0.8 * ch.breathe)
		gCrack.Transparency = 1 - iw * 0.75
		gRing.CFrame = ch.flat * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, -ch.clock * 0.8, 0)
		gRing.Transparency = 1 - iw * 0.55
		for _, h in ipairs(holes) do
			local a = ch.clock * h.sp + h.ph
			local p = ch.pos + Vector3.new(math.cos(a) * h.rad, h.h - 2 + 0.3 * math.sin(a * 2), math.sin(a) * h.rad)
			h.core.CFrame = CFrame.new(p)
			h.skP.CFrame = CFrame.new(p)
			h.core.Transparency = iw > 0.1 and 0 or 1
			h.r.CFrame = faceCam(p) * CFrame.Angles(0, ch.clock * 4, 0)
			local s = 1.5 + 0.15 * math.sin(ch.clock * 9 + h.ph)
			h.rm.Scale = Vector3.new(s, 1, s)
			h.r.Transparency = 1 - iw * 0.9
			h.sk.Rate = iw > 0.1 and 40 or 0
		end
		for _, s in ipairs(shards) do
			local a = ch.clock * s.sp + s.ph
			s.p.CFrame = CFrame.new(ch.pos + Vector3.new(math.cos(a) * s.rad, s.h - 2 + 0.25 * math.sin(ch.clock + s.ph), math.sin(a) * s.rad))
				* s.tilt * CFrame.Angles(ch.clock * 0.7, ch.clock * 0.5, 0)
			s.p.Transparency = 1 - iw
			L.tint(s.m, C1:Lerp(C2, 0.5 + 0.5 * math.sin(ch.clock * 2 + s.ph)), 1.6)
		end

		if iw > 0.8 then
			pulseT += dt
			if pulseT >= 3.5 then
				pulseT = 0
				local p0 = ch.feet
				implode(p0, C2, 20, 1, 0.55, 3)
				implode(p0, C1, 14, 1, 0.45, 2.4, "cracks_b.png")
				L.after(0.55, function()
					burst:Emit(26)
					L.groundWave(p0, "ring_c.png", W, 1, 10, 0.35)
					light.Brightness = 6
				end)
			end
		else
			pulseT = 2.2
		end
		local flick = 0.85 + 0.15 * math.sin(ch.clock * 11) * math.sin(ch.clock * 3)
		light.Brightness = math.max(on and (1 + 1.5 * sprint) * flick or iw * 1.5 * flick, light.Brightness - dt * 8)
		hl.OutlineTransparency = 0.7 - 0.45 * iw * flick

		local hp = ch.head.Position + Vector3.new(0, 1.2 + 0.08 * math.sin(ch.clock * 1.6), 0)
		local a = 0.55 + 0.45 * iw
		hCore.CFrame = CFrame.new(hp)
		hDisc.CFrame = CFrame.new(hp) * CFrame.Angles(0, ch.clock * 2, 0)
		hDiscM.Scale = Vector3.new(2.4, 1, 2.4)
		hDisc.Transparency = 1 - 0.85 * a
		hRim.CFrame = CFrame.new(hp + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, -ch.clock * 1.5, 0)
		local rs = 2.9 + 0.12 * math.sin(ch.clock * 7)
		hRimM.Scale = Vector3.new(rs, 1, rs)
		hRim.Transparency = 1 - 0.94 * a
		hRim2.CFrame = CFrame.new(hp - Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, ch.clock * 0.9, 0)
		hRim2.Transparency = 1 - 0.6 * a
		L.tint(hRimM, C2:Lerp(W, 0.25 * ch.breathe), 3)
		hSuck.Rate = 120 * a * (on and 0.6 or 1)
		hDark.Rate = 20 * a
		hLight.Brightness = (1 + 1.2 * a) * flick

		tag.step(dt)
	end
	return { arrive = arrive, step = step, rebind = rebind, short = function(n) cur = n shorts[n]() end,
		hidden = function() return hideOwner ~= dashTok and savedLTM or nil end, rig = function() return rig end, stop = function() tag.bb:Destroy() setHidden(false) end }
end

System.StaffThemes.THEMES.storm = function(L, C)
	local C1, C2, W = C.c1, C.c2, L.W
	local NS, CS, NR, K, CK = L.NS, L.CS, L.NR, L.K, L.CK
	local ch = L.ch
	local rnd, c01 = L.rnd, L.c01


	local feetP = L.part({ Size = Vector3.new(2.6, 0.2, 2.6) })
	local rise = L.pe(feetP, { Texture = L.T("spark.png"), Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top,
		Speed = NR(4, 9), Lifetime = NR(0.3, 0.6), Squash = NS(-2.5), Orientation = Enum.ParticleOrientation.VelocityParallel,
		Size = NS({ K(0, 0.2), K(1, 0) }), Color = CS(W, C1), Brightness = 6 })
	local burst = L.pe(feetP, { Texture = L.T("spark.png"), Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top,
		Speed = NR(10, 24), SpreadAngle = Vector2.new(70, 70), Acceleration = Vector3.new(0, -25, 0), Drag = 1, Lifetime = NR(0.3, 0.7),
		Size = NS({ K(0, 0.35), K(1, 0) }), Color = CS(W, C1), Brightness = 7, Orientation = Enum.ParticleOrientation.VelocityParallel, Squash = NS(-1.5) })
	local gCrack, gCrackM = L.mesh("disc.mesh", "cracks_b.png", C1, 1.6, Vector3.new(8, 1, 8))
	local gRing, gRingM = L.mesh("disc.mesh", "ring_c.png", C2, 2, Vector3.new(6.5, 1, 6.5))
	local orbs = {}
	for i = 1, 3 do
		local p = L.part()
		local a0 = L.new("Attachment", { Position = Vector3.new(0, 0.15, 0) }, p)
		local a1 = L.new("Attachment", { Position = Vector3.new(0, -0.15, 0) }, p)
		local tr = L.new("Trail", { Attachment0 = a0, Attachment1 = a1, Texture = L.T("beamb.png"), LightEmission = 1, Brightness = 6,
			Lifetime = 0.25, FaceCamera = true, Color = CS(W, i == 2 and C2 or C1), Transparency = NS(0, 1), WidthScale = NS(1, 0) }, p)
