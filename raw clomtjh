		TAGS.void = function(K, head, C1, C2)
			local frame, text, img, seg, new, T, NAME = K.frame, K.text, K.img, K.seg, K.new, K.T, K.NAME
			local bb = K.board(head, 10, 3.4, 3.7)
			local Wd, Hd = 10, 3.4
			local CY = Hd * 0.42
			img(bb, { Image = T("glowui.png"), ImageColor3 = C1, ImageTransparency = 0.55, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, CY / Hd), Size = UDim2.fromScale(1.05, 1.0), ZIndex = 0 })
			local N, SUB = 15, 3
			local xs, ys, hh, ty, th = {}, {}, {}, {}, {}
			local function shape(first)
				for i = 1, N do
					local u = (i - 1) / (N - 1)
					local pinch = (i % 4 == 0) and 0.6 or 1
					ty[i] = CY + ((i == 1 or i == N) and 0 or rnd(-0.16, 0.16))
					th[i] = math.sin(u * math.pi) ^ 0.5 * (first and rnd(0.62, 0.9) or rnd(0.66, 0.86)) * pinch
				end
			end
			shape(true)
			for i = 1, N do xs[i] = 0.3 + (i - 1) / (N - 1) * (Wd - 0.6) ys[i] = ty[i] hh[i] = th[i] end
			local EDGE = W:Lerp(C2, 0.35)
			local fills, tops, bots, gT, gB = {}, {}, {}, {}, {}
			for i = 1, N - 1 do
				fills[i] = {}
				for k = 1, SUB do fills[i][k] = { seg(bb, Wd, Hd, BLACK, 0, 2) } end
				gT[i] = { seg(bb, Wd, Hd, C1, 0.6, 2) } gB[i] = { seg(bb, Wd, Hd, C1, 0.6, 2) }
				tops[i] = { seg(bb, Wd, Hd, EDGE, 0, 4) } bots[i] = { seg(bb, Wd, Hd, EDGE, 0, 4) }
			end
			local stars = {}
			for n = 1, 16 do
				stars[n] = { f = frame(bb, { BackgroundTransparency = 0, BackgroundColor3 = n % 3 == 0 and C2:Lerp(W, 0.5) or W, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 3 }),
					x = rnd(0.6, Wd - 0.6), v = rnd(0.15, 0.4), off = rnd(-0.75, 0.75), s = rnd(0.025, 0.05), ph = rnd(0, 6) }
			end
			local hair = {}
			for n = 1, 4 do
				local sd = n % 2 == 0 and 1 or -1
				hair[n] = { i = 2 + n * 3 % (N - 3), sd = sd, d1 = Vector2.new(rnd(-0.3, 0.3), sd * rnd(0.2, 0.32)), d2 = Vector2.new(rnd(-0.25, 0.25), sd * rnd(0.12, 0.2)),
					a = { seg(bb, Wd, Hd, EDGE, 0.2, 3) }, b = { seg(bb, Wd, Hd, EDGE, 0.4, 3) }, on = true }
			end
			local box = frame(bb, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, CY / Hd), Size = UDim2.fromScale(0.72, 0.3) })
			local function nameLbl(col, z) return text(box, { Size = UDim2.fromScale(1, 1), Text = NAME, FontFace = fam("Zekton"), TextColor3 = col, ZIndex = z }) end
			local nm = nameLbl(W, 5)
			new("UIGradient", { Color = CS({ CK(0, C2:Lerp(W, 0.5)), CK(0.5, W), CK(1, C1:Lerp(W, 0.5)) }) }, nm)
			new("UIStroke", { Color = C1, Thickness = 1.2, Transparency = 0.35 }, nm)
			local gh1, gh2 = nameLbl(C2, 4), nameLbl(Color3.fromRGB(90, 230, 255), 4)
			local role = text(bb, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.87), Size = UDim2.fromScale(0.2, 0.1), Text = "S T A F F", FontFace = fam("Zekton"),
				TextColor3 = C2:Lerp(W, 0.5), ZIndex = 5 })
			K.emitterAt(Vector3.new(0, 3.7, 0), { box = Vector3.new(9, 2.6, 0.2), Shape = Enum.ParticleEmitterShape.Box, ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward,
				Texture = T("spark.png"), Color = CS(C2, C1), Size = NS({ NK(0, 0.1), NK(1, 0) }), Speed = NR(1.5, 3), Lifetime = NR(0.5, 0.8), Rate = 16, Brightness = 3, ZOffset = 1 })
			local nextG, gEnd, nextS = 2, 0, 3
			local function at(xx)
				local f = (xx - xs[1]) / (xs[N] - xs[1]) * (N - 1) + 1
				local i = math.clamp(math.floor(f), 1, N - 1)
				local u = f - i
				return ys[i] + (ys[i + 1] - ys[i]) * u, hh[i] + (hh[i + 1] - hh[i]) * u
			end
			return function(t, dt, it)
				local span = outQ(it / 0.35)
				local part = outB((it - 0.25) / 0.35)
				if t >= nextS then nextS = t + rnd(3, 4.5) shape(false) end
				local k = math.min(1, dt * 1.2)
				for i = 1, N do ys[i] = ys[i] + (ty[i] - ys[i]) * k hh[i] = hh[i] + (th[i] - hh[i]) * k end
				local b = beat(t, 1.6)
				local open = math.max(part, 0) * (0.94 + 0.06 * b)
				local function X(i) return Wd / 2 + (xs[i] - Wd / 2) * span end
				for i = 1, N - 1 do
					local h1, h2 = hh[i] * open, hh[i + 1] * open
					local x1, x2 = X(i), X(i + 1)

					for s = 1, SUB do
						local u0, u1 = (s - 1) / SUB, s / SUB
						local ax, bx = x1 + (x2 - x1) * u0, x1 + (x2 - x1) * u1
						local ay, by = ys[i] + (ys[i + 1] - ys[i]) * u0, ys[i] + (ys[i + 1] - ys[i]) * u1
						local ha, hb = h1 + (h2 - h1) * u0, h1 + (h2 - h1) * u1
						fills[i][s][2](ax, ay, bx, by, 2 * math.min(ha, hb) * 0.97)
						fills[i][s][1].Visible = open > 0.02
					end
					tops[i][2](x1, ys[i] - h1, x2, ys[i + 1] - h2, 0.045) bots[i][2](x1, ys[i] + h1, x2, ys[i + 1] + h2, 0.045)
					gT[i][2](x1, ys[i] - h1, x2, ys[i + 1] - h2, 0.24 + 0.1 * b) gB[i][2](x1, ys[i] + h1, x2, ys[i + 1] + h2, 0.24 + 0.1 * b)
					local vis = span > 0.02
					tops[i][1].Visible, bots[i][1].Visible, gT[i][1].Visible, gB[i][1].Visible = vis, vis, vis, vis
				end
				for _, s in ipairs(stars) do
					s.x = s.x - s.v * dt
					if s.x < 0.6 then s.x = Wd - 0.6 s.off = rnd(-0.75, 0.75) end
					local cy, h = at(s.x)
					local yy = cy + s.off * h * open
					s.f.Position = UDim2.fromScale((Wd / 2 + (s.x - Wd / 2) * span) / Wd, yy / Hd)
					local sz = s.s * (0.7 + 0.3 * math.sin(t * 3 + s.ph))
					s.f.Size = UDim2.fromScale(sz / Wd, sz / Hd)
					s.f.Visible = open > 0.3 and math.abs(s.off) * h * open < h * open - 0.08
				end
				for _, q in ipairs(hair) do
					if math.random() < dt * 1.5 then q.on = not q.on end
					local o = Vector2.new(X(q.i), ys[q.i] + q.sd * hh[q.i] * open)
					local g = c01((it - 0.45) / 0.3)
					local p1, p2 = o + q.d1 * g, o + q.d1 * g + q.d2 * g
					q.a[2](o.X, o.Y, p1.X, p1.Y, 0.022) q.b[2](p1.X, p1.Y, p2.X, p2.Y, 0.016)
					q.a[1].Visible, q.b[1].Visible = g > 0 and q.on, g > 0 and q.on
				end
				local nIn = c01((it - 0.5) / 0.4)
				if t >= nextG then gEnd = t + 0.14 nextG = t + rnd(2.5, 4.5) end
				local glitch = t < gEnd or (nIn > 0 and nIn < 1 and math.random() < 0.5)
				nm.TextTransparency = nIn >= 1 and 0 or (glitch and 0.2 or 1 - nIn)
				role.TextTransparency = 1 - c01((it - 0.8) / 0.3)
				if glitch then
					local j = rnd(-0.015, 0.015)
					nm.Position = UDim2.fromScale(j, rnd(-0.04, 0.04))
					gh1.Position, gh2.Position = UDim2.fromScale(j - 0.012, 0), UDim2.fromScale(j + 0.012, 0)
					gh1.TextTransparency, gh2.TextTransparency = 0.2, 0.3
				else
					nm.Position = UDim2.fromScale(0, 0)
					gh1.TextTransparency, gh2.TextTransparency = 1, 1
				end
			end
		end




