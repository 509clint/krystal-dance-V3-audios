		gHex.CFrame = ch.flat * CFrame.new(0, 0.07, 0) * CFrame.Angles(0, -ch.clock * 0.1, 0)
		gHex.Transparency = 1 - iw * 0.45
		gRing.CFrame = ch.flat * CFrame.new(0, 0.09, 0) * CFrame.Angles(0, ch.clock * 0.4, 0)
		gRing.Transparency = 1 - iw * 0.5
		for _, ob in ipairs(orbs) do
			local a = ch.clock * ob.sp + ob.ph
			ob.p.CFrame = CFrame.new(ch.pos + Vector3.new(math.cos(a) * ob.r, ob.h - 2 + 0.25 * math.sin(ch.clock + ob.ph), math.sin(a) * ob.r))
				* CFrame.Angles(0.3 * math.sin(ch.clock + ob.ph), a, 0.25)
			ob.p.Transparency = 1 - iw * 0.85
			L.tint(ob.m, C1:Lerp(W, 0.5 + 0.5 * math.sin(ch.clock * 2.5 + ob.ph * 3)), 1.6)
			ob.ge.Rate = 3 * iw
		end

		if iw > 0.8 then
			bloomT += dt
			if bloomT >= 3.2 then
				bloomT = 0
				local o = ch.feet
				local off = rnd(0, 6)
				for i = 1, 6 do
					local a = off + i / 6 * math.pi * 2
					local d = Vector3.new(math.cos(a), 0, math.sin(a))
					local p, m, set = crystal(o + d * rnd(2.6, 3.4), rnd(0.35, 0.55), leanOut(d, math.rad(rnd(20, 35))), i % 2 == 0 and C2 or C1)
					local hh, dl = rnd(1, 1.8), i * 0.04
					L.fx(1.3, function(k, t)
						local g = c01((t - dl) / 0.15)
						local fall = c01((k - 0.65) / 0.35)
						set(hh * (1 - (1 - g) ^ 3) * (1 - fall), g > 0 and (0.15 + 0.85 * fall) or 1, 1.6 + 1.5 * (1 - g))
						if fall > 0 and not m:GetAttribute("b") then m:SetAttribute("b", true) burstP.CFrame = p.CFrame burst:Emit(3) end
					end, { p })
				end
				L.groundWave(o, "hex.png", C2, 2, 12, 0.9, 2)
				light.Brightness = 5
			end
		else
			bloomT = 2
		end
		local tw = 0.9 + 0.1 * math.sin(ch.clock * 5)
		light.Brightness = math.max(on and (1 + sprint) * tw or iw * 1.5 * tw, light.Brightness - dt * 8)
		hl.OutlineTransparency = 0.75 - 0.4 * iw

		local hp = ch.head.Position + Vector3.new(0, 1.2 + 0.08 * math.sin(ch.clock * 1.6), 0)
		local a = 0.55 + 0.45 * iw
		local rot = ch.clock * 0.5
		halo.CFrame = CFrame.new(hp) * CFrame.Angles(0, -rot, 0)
		halo.Transparency = 1 - a * 0.85
		L.tint(haloM, C2:Lerp(W, 0.3 * ch.breathe), 2.2)
		crownP.CFrame = CFrame.new(hp)
		for _, c in ipairs(crown) do
			local ca = c.a + rot
			local pos = hp + Vector3.new(math.cos(ca) * 1.25, c.h * 0.5, math.sin(ca) * 1.25)
			c.p.CFrame = CFrame.new(pos) * CFrame.Angles(0, -ca, 0) * CFrame.Angles(0, 0, math.rad(-12))
			c.p.Transparency = 1 - a * 0.9
			L.tint(c.m, C1:Lerp(W, 0.5 + 0.5 * math.sin(ch.clock * 3 + c.a * 2)), 1.7)
		end
		crownGlint.Rate = 10 * a
		crownSnow.Rate = 6 * a * (on and 0.5 or 1)
		crownLight.Brightness = 1 + 1.2 * a

		tag.step(dt)
	end
	return { arrive = arrive, step = step, rebind = rebind, short = function(n) cur = n shorts[n]() end,
		hidden = function() return hideOwner ~= dashTok and savedLTM or nil end, rig = function() return rig end, stop = function() tag.bb:Destroy() setHidden(false) end }
end


System.StaffThemes.THEMES.vampire = function(L, C)
	local C1, C2, W = C.c1, C.c2, L.W
	local NS, CS, NR, K, CK = L.NS, L.CS, L.NR, L.K, L.CK
	local ch = L.ch
	local rnd, c01 = L.rnd, L.c01
	local BLACK = Color3.fromRGB(12, 2, 5)
	local GORE = C1:Lerp(BLACK, 0.45)

	local function batE(parent, props)
		local p = { Texture = L.T("bat_fb.png"), FlipbookLayout = Enum.ParticleFlipbookLayout.Grid2x2, FlipbookMode = Enum.ParticleFlipbookMode.Loop,
			FlipbookFramerate = NR(12, 18), FlipbookStartRandom = true, Color = CS(BLACK, GORE), LightEmission = 0, Brightness = 1,
			Size = NS(0.9), Lifetime = NR(0.8, 1.3), Speed = NR(4, 8), SpreadAngle = Vector2.new(180, 180), Drag = 1,
			Transparency = NS({ K(0, 1), K(0.1, 0), K(0.85, 0), K(1, 1) }) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function mistE(parent, props)
		local p = { Texture = L.T("smoke.png"), Color = CS(C1, GORE), LightEmission = 0.25, Brightness = 1.2,
			Transparency = NS({ K(0, 1), K(0.3, 0.55), K(1, 1) }), Size = NS({ K(0, 1.5), K(1, 4) }), Lifetime = NR(1.4, 2.2),
			Speed = NR(0.4, 1.2), RotSpeed = NR(-25, 25), Rotation = NR(0, 360) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function dropE(parent, props)
		local p = { Texture = L.T("drop.png"), Color = CS(C2, C1), LightEmission = 0.2, Brightness = 1.5, Size = NS({ K(0, 0.22), K(1, 0.16) }),
			Lifetime = NR(0.6, 0.9), Speed = NR(0, 1), Acceleration = Vector3.new(0, -30, 0), Orientation = Enum.ParticleOrientation.FacingCameraWorldUp, Rotation = NR(0, 0),
			Transparency = NS({ K(0, 0), K(0.85, 0), K(1, 1) }) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function faceCam(pos)
		local cp = workspace.CurrentCamera.CFrame.Position
		if (cp - pos).Magnitude < 0.05 then return CFrame.new(pos) end
		return CFrame.lookAt(pos, cp) * CFrame.Angles(math.rad(90), 0, 0)
	end


	local savedLTM, hideChar, hideOwner, hideGen, dashTok = nil, nil, nil, 0, nil
	local function setHidden(on, tok)
		if on then
			hideGen += 1
			local my = hideGen
			hideOwner = my
			task.delay(15, function() setHidden(false, my) end)
			if savedLTM and hideChar == ch.char then return my end
			if not ch.char then return my end
			savedLTM, hideChar = {}, ch.char
			for _, d in ipairs(ch.char:GetDescendants()) do
				if d:IsA("BasePart") or d:IsA("Decal") then savedLTM[d] = d.LocalTransparencyModifier d.LocalTransparencyModifier = 1 end
			end
			return my
		elseif savedLTM then
			if tok and tok ~= hideOwner then return end
			for d, v in pairs(savedLTM) do if d.Parent then d.LocalTransparencyModifier = v end end
			if tok and tok ~= dashTok then L.punch(1.1, 0.3) end
			savedLTM, hideChar, hideOwner = nil, nil, nil
		end
	end

	local function swarm(start, rate)
		local p = L.part({ Size = Vector3.one * 2, CFrame = CFrame.new(start) })
		local e = batE(p, { Rate = rate or 40, Speed = NR(1, 3), Lifetime = NR(0.5, 0.8), Shape = Enum.ParticleEmitterShape.Box })
		return p, e
	end


	local feetP = L.part({ Size = Vector3.new(5, 0.2, 5) })
	local burstP = L.part({ Size = Vector3.one * 2 })
	local auraMist = mistE(feetP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top, Speed = NR(0.2, 0.6),
		Acceleration = Vector3.new(0, -0.15, 0), Size = NS({ K(0, 2), K(1, 4.5) }) })
	local batBurst = batE(burstP, { Speed = NR(10, 18), Lifetime = NR(0.9, 1.4), Drag = 1.5 })
	local dropBurst = dropE(burstP, { Speed = NR(8, 16), SpreadAngle = Vector2.new(70, 70), EmissionDirection = Enum.NormalId.Top, Lifetime = NR(0.7, 1.1) })
	local gSig, gSigM = L.mesh("disc.mesh", "glyph.png", C1, 1.8, Vector3.new(8, 1, 8))
	local gRing, gRingM = L.mesh("disc.mesh", "ring_c.png", C2, 2, Vector3.new(6, 1, 6))
	local gPool, gPoolM = L.mesh("disc.mesh", "glowui.png", GORE, 1, Vector3.new(6, 1, 6))
	local drip = dropE(L.new("Attachment", {}, burstP), { Rate = 0 })
	local dripP = L.part({ Size = Vector3.new(1.4, 0.2, 0.8) })
	local dripE = dropE(dripP, { Shape = Enum.ParticleEmitterShape.Box, Rate = 0, Speed = NR(0, 0.5) })

	local bats = {}
	for i = 1, 3 do
		local p = L.part({ Size = Vector3.one * 0.2 })
		local e = batE(p, { Rate = 4, Speed = NR(0, 0), Lifetime = NR(0.35, 0.35), LockedToPart = true, SpreadAngle = Vector2.zero,
			Transparency = NS(0), Size = NS(0.75), Drag = 0 })
		bats[i] = { p = p, e = e, ph = i / 3 * math.pi * 2, r = 3.2 + i * 0.4, h = 2 + i * 0.6, sp = 1.2 + i * 0.15 }
	end

	local crown, crownM = L.mesh("disc.mesh", "ring_c.png", C1, 2.4, Vector3.new(2.3, 1, 2.3))
	local crownIn, crownInM = L.mesh("disc.mesh", "ring_c.png", GORE, 1.2, Vector3.new(2.0, 1, 2.0))
	local crownG, crownGM = L.mesh("disc.mesh", "glowui.png", C1, 1.1, Vector3.new(3.2, 1, 3.2))
	local hang = {}
	for i = 1, 8 do
		local p, m = L.mesh("quad.mesh", "drop.png", C1, 1.25, Vector3.new(0.15, 1, 0.3))
		hang[i] = { p = p, m = m, a = i / 8 * math.pi * 2 + rnd(-0.15, 0.15), g = rnd(0, 1), sp = rnd(0.35, 0.6) }
	end
	local fallP = L.part({ Size = Vector3.one * 0.1 })
	local fallE = dropE(fallP, { Rate = 0, Speed = NR(0, 0), SpreadAngle = Vector2.zero, Acceleration = Vector3.new(0, -26, 0), Lifetime = NR(0.5, 0.6),
		Size = NS({ K(0, 0.16), K(1, 0.1) }) })
	local haloLight = L.new("PointLight", { Color = C1, Range = 10, Brightness = 1.5, Shadows = false }, crown)

	local rig, light, hl = {}, nil, nil
	local function rebind()
		for _, o in ipairs(rig) do o:Destroy() end
		rig = {}
		local hrp = ch.hrp
		local function att(pos) local a = L.new("Attachment", { Position = pos }, hrp) rig[#rig + 1] = a return a end
		local function trail(a0, a1, props) local t = L.new("Trail", props, hrp) t.Attachment0, t.Attachment1 = a0, a1 rig[#rig + 1] = t return t end
		rig.main = trail(att(Vector3.new(0, 1.2, 0.3)), att(Vector3.new(0, -1.5, 0.3)), { Texture = L.T("beamb.png"), LightEmission = 0.2, Brightness = 1.5,
			Lifetime = 0.45, FaceCamera = true, Enabled = false, Color = CS({ CK(0, C2), CK(0.4, C1), CK(1, BLACK) }),
			Transparency = NS({ K(0, 0.2), K(1, 1) }), WidthScale = NS({ K(0, 1), K(1, 0.35) }) })
		local back = att(Vector3.new(0, -0.8, 0.6))
		rig.mist = mistE(back, { Speed = NR(0.5, 1.5), Lifetime = NR(0.9, 1.4), Size = NS({ K(0, 1.4), K(1, 3) }) })
		rig.bats = batE(att(Vector3.new(0, 0.5, 0.6)), { Speed = NR(4, 8), Lifetime = NR(0.6, 0.9), EmissionDirection = Enum.NormalId.Back, SpreadAngle = Vector2.new(50, 50) })
		for _, e in ipairs({ rig.mist, rig.bats }) do rig[#rig + 1] = e end
		light = L.new("PointLight", { Color = C1, Range = 14, Brightness = 0, Shadows = false }, hrp) rig[#rig + 1] = light
		hl = L.new("Highlight", { FillColor = C1, FillTransparency = 1, OutlineColor = C1, Adornee = ch.char, DepthMode = Enum.HighlightDepthMode.Occluded }, L.root)
		rig[#rig + 1] = hl
	end
	rebind()
	local tag = System.StaffThemes.headTag(L, "vampire", C1, C2, { c1 = C1, c2 = C2, grad = CS({ CK(0, GORE), CK(0.35, C1), CK(0.5, C2), CK(0.65, C1), CK(1, GORE) }) })


	local function appear(col, fill, tok)
		setHidden(false, tok)
		hl.FillColor, hl.FillTransparency = col or C2, fill or 0.2
	end

	local function body(col, mat)
		local m = Instance.new("Model")
		local base = {}
		for _, p in ipairs(ch.char:GetDescendants()) do
			local ltm = savedLTM and savedLTM[p] or (p:IsA("BasePart") and p.LocalTransparencyModifier) or 1
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 and ltm < 1 then
				local g = p:Clone()
				for _, d in ipairs(g:GetChildren()) do if not d:IsA("DataModelMesh") then d:Destroy() end end
				g.Anchored, g.CanCollide, g.CanQuery, g.CanTouch, g.CastShadow = true, false, false, false, false
				g.Material, g.Color = mat or Enum.Material.SmoothPlastic, col
				if g:IsA("MeshPart") then g.TextureID = "" end
				g.Transparency = 1
				g.Parent = m
				base[g] = p.CFrame
			end
		end
		m.Parent = L.root
		return m, base
	end
	local function bodySet(base, off, tr, col)
		for g, cf in pairs(base) do
			if g.Parent then
				g.CFrame = cf - Vector3.new(0, off, 0)
				g.Transparency = tr
				if col then g.Color = col end
			end
		end
	end

	local function eyes(head, life)
		local ps, ms = {}, {}
		for i = 1, 2 do ps[i], ms[i] = L.mesh("disc.mesh", "glowui.png", C2, 4) end
		L.fx(life, function(k, t)
			local a = c01(t / 0.3) * (1 - c01((k - 0.85) / 0.15))
			local hc = head()
			for i, p in ipairs(ps) do
				local pos = (hc * CFrame.new((i == 1 and -1 or 1) * 0.22, 0.1, -0.64)).Position
				p.CFrame = faceCam(pos)
				local s = 0.32 + 0.06 * math.sin(t * 9)
				ms[i].Scale = Vector3.new(s * 1.7, 1, s * 0.8)
				p.Transparency = math.max(0.06, 1 - a)
			end
		end, ps)
	end

	local function thorn(base, dir, w)
		if Vector3.new(dir.X, 0, dir.Z).Magnitude < 0.01 then dir = (dir + Vector3.new(0.02, 0, 0)).Unit end
		local p, m = L.mesh("shard.mesh", nil, GORE, 1.5, Vector3.new(w, 0.01, w))
		p.Color, p.Material, p.Transparency = GORE, Enum.Material.SmoothPlastic, 0 m.VertexColor = Vector3.one
		local cf0 = CFrame.lookAt(base, base + dir) * CFrame.Angles(-math.pi / 2, 0, 0)
		local function set(h, tr)
			h = math.max(h, 0.01)
			m.Scale = Vector3.new(w, h, w)
			p.CFrame = cf0 * CFrame.new(0, h / 2, 0)
			p.Transparency = tr or 0
		end
		set(0, 1)
		return p, set
	end
	local function shatter(pos, n, spd, s)
		for i = 1, n do
			local sc = i % 3 == 0 and C1 or GORE
			local p, m = L.mesh("shard.mesh", nil, sc, 1, Vector3.new(0.3, 0.8, 0.3) * rnd(0.6, 1.4) * s)
			p.Color, p.Material, p.Transparency = sc, Enum.Material.SmoothPlastic, 0 m.VertexColor = Vector3.one
			local v = Vector3.new(rnd(-1, 1), rnd(0.2, 1.1), rnd(-1, 1)).Unit * rnd(0.5, 1) * spd
			local p0 = pos + Vector3.new(rnd(-1, 1), rnd(0, 2), rnd(-1, 1)) * s
			local spin = CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6))
			local sx, sy = rnd(-8, 8), rnd(-8, 8)
			local floor = ch.feet.Y + 0.2
			p.CFrame = CFrame.new(p0)
			L.fx(rnd(1, 1.5), function(k, t)
				local pp = p0 + v * t + Vector3.new(0, -40 * t * t, 0)
				if pp.Y < floor then pp = Vector3.new(pp.X, floor, pp.Z) end
				p.CFrame = CFrame.new(pp) * spin * CFrame.Angles(t * sx, t * sy, 0)
				p.Transparency = math.max(0.06, c01((k - 0.6) / 0.4))
			end, { p })
		end
	end

	local function pillar(base, w)
		local outer = L.part({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = C1, Transparency = 0.35 })
		local inner = L.part({ Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic, Color = GORE, Transparency = 0.06 })
		local top = L.part({ Size = Vector3.new(w, 0.2, w) })
		local sp = dropE(top, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top, Speed = NR(6, 12), SpreadAngle = Vector2.new(35, 35),
			Acceleration = Vector3.new(0, -40, 0), Size = NS({ K(0, 0.35), K(1, 0.2) }), Lifetime = NR(0.6, 0.9) })
		local function set(h, rate)
			local on = h > 0.05
			h = math.max(h, 0.05)
			local cf = CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			outer.Size, outer.CFrame, outer.Transparency = Vector3.new(h, w, w), cf, on and 0.35 or 1
			inner.Size, inner.CFrame, inner.Transparency = Vector3.new(h, w * 0.7, w * 0.7), cf, on and 0.06 or 1
			top.CFrame = CFrame.new(base + Vector3.new(0, h, 0))
			sp.Rate = on and (rate or 0) or 0
		end
		set(0)
		return { outer, inner, top }, set
	end


	local function crossPillar(base, look, H)
		local w, bar, barY = H * 0.14, H * 0.6, H * 0.34
		local f = Vector3.new(look.X, 0, look.Z).Unit
		local rot = CFrame.lookAt(Vector3.zero, f)
		local function mk(mat, col, tr, s) return L.part({ Material = mat, Color = col, Transparency = tr }), s end
		local vO = mk(Enum.Material.Neon, C1, 0)
		local vI = mk(Enum.Material.SmoothPlastic, BLACK, 0)
		local hO = mk(Enum.Material.Neon, C1, 0)
		local hI = mk(Enum.Material.SmoothPlastic, BLACK, 0)
		vO.Size, vI.Size = Vector3.new(w, H, w), Vector3.new(w * 0.22, H - w * 0.6, w * 1.25)
		hO.Size, hI.Size = Vector3.new(bar, w, w), Vector3.new(bar - w * 0.6, w * 0.22, w * 1.25)
		local top = L.part({ Size = Vector3.new(w, 0.2, w) })
		local sp = dropE(top, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top, Speed = NR(6, 12), SpreadAngle = Vector2.new(35, 35),
			Acceleration = Vector3.new(0, -40, 0), Size = NS({ K(0, 0.35), K(1, 0.2) }), Lifetime = NR(0.6, 0.9) })
		local function set(h, rate)
			local on = h > 0.05
			local bottom = base.Y + h - H
			local vc = CFrame.new(base.X, bottom + H / 2, base.Z) * rot
			local hc = CFrame.new(base.X, bottom + barY, base.Z) * rot
			vO.CFrame, vI.CFrame, hO.CFrame, hI.CFrame = vc, vc, hc, hc
			vO.Transparency, hO.Transparency = on and 0 or 1, (on and bottom + barY + w / 2 > base.Y) and 0 or 1
			vI.Transparency, hI.Transparency = on and 0 or 1, (on and bottom + barY + w / 2 > base.Y) and 0 or 1
			top.CFrame = CFrame.new(base.X, base.Y + h, base.Z)
			sp.Rate = on and (rate or 0) or 0
		end
		set(0)
		return { vO, vI, hO, hI, top }, set
	end

	local function pool(o, size, life, grow)
		local p, m = L.mesh("disc.mesh", "glowui.png", GORE, 1.2)
		local q, qm = L.mesh("disc.mesh", "cracks_b.png", C1, 1.6)
		L.fx(life, function(k, t)
			local s = size * L.outQuad(c01(t / grow))
			m.Scale = Vector3.new(s, 1, s) qm.Scale = Vector3.new(s * 0.9, 1, s * 0.9)
			p.CFrame = CFrame.new(o + Vector3.new(0, 0.05, 0)) q.CFrame = CFrame.new(o + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, t * 0.3, 0)
			local f = c01((k - 0.7) / 0.3)
			p.Transparency = 0.06 + 0.94 * f q.Transparency = 0.35 + 0.65 * f
		end, { p, q })
	end
	local function camBasis() return L.facing() end



	local function giant(G)
		local m = Instance.new("Model")
		local hrp = ch.hrp
		local parts = {}
		for _, p in ipairs(ch.char:GetDescendants()) do
			local ltm = savedLTM and savedLTM[p] or (p:IsA("BasePart") and p.LocalTransparencyModifier) or 1
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 and ltm < 1 then
				local g = p:Clone()
				for _, d in ipairs(g:GetChildren()) do


					if d:IsA("SpecialMesh") then if d.MeshType == Enum.MeshType.FileMesh then d.Scale = d.Scale * G end elseif not d:IsA("DataModelMesh") then d:Destroy() end
				end
				g.Anchored, g.CanCollide, g.CanQuery, g.CanTouch, g.CastShadow = true, false, false, false, false
				g.Material, g.Color = Enum.Material.SmoothPlastic, BLACK
				if g:IsA("MeshPart") then g.TextureID = "" end
				g.Size = p.Size * G
				g.Transparency = 1
				g.Parent = m
				parts[g] = hrp.CFrame:ToObjectSpace(p.CFrame)
			end
		end
		local headRel = ch.head and hrp.CFrame:ToObjectSpace(ch.head.CFrame) or CFrame.new(0, 1.5, 0)
		m.Parent = L.root
		local cur = CFrame.identity
		local function set(anchor, tr)
			cur = anchor
			for g, rel in pairs(parts) do
