		h.light = L.new("PointLight", { Color = C2, Range = 30, Brightness = 0, Shadows = false }, h.inP)
		h.objs = { h.core, h.r1, h.r2, h.acc, h.inP }
		function h.set(pos, size, t, vis)
			h.core.Size = Vector3.one * math.max(size, 0.05)
			h.core.CFrame = CFrame.new(pos)
			h.core.Transparency = (vis and size > 0.06) and 0 or 1
			local rs = size * 2.6 + 0.3 * math.sin(t * 20)
			h.r1m.Scale = Vector3.new(rs, 1, rs) h.r1.CFrame = faceCam(pos)
			h.r2m.Scale = Vector3.new(rs * 1.35, 1, rs * 1.35) h.r2.CFrame = faceCam(pos) * CFrame.Angles(0, -t * 3, 0)
			local a = vis and c01(size / 0.6) or 0
			h.r1.Transparency, h.r2.Transparency = 1 - 0.95 * a, 1 - 0.7 * a
			local as = size * 4.5
			h.accM.Scale = Vector3.new(as, as * 0.08, as)
			h.acc.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(18), -t * 8, 0)
			h.acc.Transparency = 1 - 0.9 * a
			h.inP.CFrame = CFrame.new(pos)
			h.inP.Size = Vector3.one * math.max(size * 6, 1)
			h.stream.Rate = vis and streamRate * a or 0
			h.light.Brightness = 6 * a
		end
		return h
	end

	local shorts = {}

	shorts[1] = function()
