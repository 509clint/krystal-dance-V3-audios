			end



			if paused[model] then drv.wasPaused = true; return end
			if drv.wasPaused then
				drv.wasPaused, drv.key = nil, false
				for part, m in pairs(drv.motors) do if m.Parent then drv.last[part] = m.Transform end end
			end
			local pose, key = nil, ""
			if not paused[model] and not drv.posed then
				local e = drv.emote
