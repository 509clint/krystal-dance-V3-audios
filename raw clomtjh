	function Function._oilGloss(v, ObjectInstance, DataDetail)
		if not (v and v:IsA("BasePart") and v.Parent) or v.Transparency >= 1 then return end
		local name = v.Name .. "RCGLOSS"
		local old = v:FindFirstChild(name); if old then old:Destroy() end
		local s = v:Clone()
		s:ClearAllChildren()
		s.Name = name
		pcall(function() s.TextureID = "" end)
		s.Material = Enum.Material.Glass; s.Transparency = 0.8; s.Reflectance = 0.25
		s.Anchored, s.CanCollide, s.CanQuery, s.CanTouch, s.Massless, s.CastShadow = false, false, false, false, true, false
		s.Size = v.Size * 1.002
		s.CFrame = v.CFrame




		local sm = (not v:IsA("MeshPart")) and v:FindFirstChildOfClass("SpecialMesh") or nil
		if sm then
			local m = sm:Clone(); m:ClearAllChildren()
			pcall(function() m.TextureId = "" end)
			m.Scale = sm.Scale * 1.002
			m.Parent = s
			sm:GetPropertyChangedSignal("Scale"):Connect(function() if m.Parent then m.Scale = sm.Scale * 1.002 end end)
		end
		v:GetPropertyChangedSignal("Size"):Connect(function() if s.Parent then s.Size = v.Size * 1.002 end end)
		local w = Instance.new("WeldConstraint"); w.Part0 = s; w.Part1 = v; w.Parent = s
		s.Parent = v
		DataDetail.CurrentPartList.Link[s] = { T = v, Define = 0.8 }
		local function gone() if s.Parent then s:Destroy() end end
		if ObjectInstance then
			ObjectInstance.AncestryChanged:Connect(function(_, p) if not p then gone() end end)
			if not ObjectInstance.Parent then gone() end
		end
	end
