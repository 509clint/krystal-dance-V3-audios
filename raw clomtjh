			{ "Head", "UpperTorso", Vector3.new(0, 0.8, 0), Vector3.new(0, -0.5, 0) },
		}
		for _, s in ipairs({ { "Left", -1 }, { "Right", 1 } }) do
			local n, x = s[1], s[2]
			table.insert(CHAIN, { n .. "UpperArm", "UpperTorso", Vector3.new(x, 0.56, 0), Vector3.new(-0.5 * x, 0.42, 0) })
			table.insert(CHAIN, { n .. "LowerArm", n .. "UpperArm", Vector3.new(0, -0.3, 0), Vector3.new(0, 0.26, 0) })
			table.insert(CHAIN, { n .. "UpperLeg", "LowerTorso", Vector3.new(0.5 * x, -0.2, 0), Vector3.new(0, 0.42, 0) })
			table.insert(CHAIN, { n .. "LowerLeg", n .. "UpperLeg", Vector3.new(0, -0.4, 0), Vector3.new(0, 0.38, 0) })
		end
		local RIDES = { Torso = "UpperTorso", Head = "Head", ["Left Arm"] = "LeftLowerArm", ["Right Arm"] = "RightLowerArm", ["Left Leg"] = "LeftLowerLeg", ["Right Leg"] = "RightLowerLeg" }
		local R6REST = { Torso = Vector3.zero, Head = Vector3.new(0, 1.5, 0), ["Left Arm"] = Vector3.new(-1.5, 0, 0), ["Right Arm"] = Vector3.new(1.5, 0, 0), ["Left Leg"] = Vector3.new(-0.5, -2, 0), ["Right Leg"] = Vector3.new(0.5, -2, 0) }
		local function chain(p)
			local w = {}
			for _, j in ipairs(CHAIN) do
				local parent = j[2] and w[j[2]] or CFrame.identity
				w[j[1]] = parent * CFrame.new(j[3]) * (p[j[1]] or CFrame.identity) * CFrame.new(j[4]):Inverse()
			end
			return w
		end
		local OFFSET = {}
		do
			local rest = chain({})
			for part, r15 in pairs(RIDES) do OFFSET[part] = rest[r15]:Inverse() * CFrame.new(R6REST[part]) end
