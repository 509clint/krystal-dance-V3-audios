			for _, r in ipairs(runs) do
				local g = c01((t - r.at) / r.dur)
				local e = r.A:Lerp(r.B, g)
				local len = (e - r.A).Magnitude
				r.p.Size = Vector3.new(0.24, 0.05, math.max(0.1, len))
				r.p.CFrame = CFrame.lookAt((r.A + e) / 2, r.B)
				r.p.Transparency = g > 0 and fade or 1
				r.h.CFrame = CFrame.new(e + Vector3.new(0, 0.08, 0))
				r.h.Transparency = (g > 0 and g < 1) and 0 or 1
			end
			local f = c01((t - HEX - 0.6) / 0.3)

			local lift = L.outQuad(c01((t - SEAL) / 0.6)) * (1 - L.inQuad(c01((t - BURST) / 0.5)))
			local sy = 0.07 + 4.2 * lift
			local ss = 1 - 0.45 * lift
			sgM.Scale, rgM.Scale = Vector3.new(RAD * 1.9 * ss, 1, RAD * 1.9 * ss), Vector3.new(RAD * 2.2 * ss, 1, RAD * 2.2 * ss)
			sg.CFrame = CFrame.new(o + Vector3.new(0, sy, 0)) * CFrame.Angles(0, t * (0.3 + 2.5 * lift), 0)
			rg.CFrame = CFrame.new(o + Vector3.new(0, sy + 0.01, 0)) * CFrame.Angles(0, -t * 1.5 * lift, 0)
			L.tint(sgM, GORE:Lerp(C1, f):Lerp(W, 0.3 * lift), 1 + 0.8 * f + 0.8 * lift)
			L.tint(rgM, GORE:Lerp(C1, f), 1 + f + lift)
			sg.Transparency, rg.Transparency = 0.5 - 0.4 * f + 0.5 * fade, 0.5 - 0.4 * f + 0.5 * fade
			bk.Transparency = 0.35 + 0.65 * fade

			for _, s in ipairs(streams) do
				local u = c01((t - SPIRAL) / 0.5)
				if u > 0 and u < 1 then
					local a = s.a0 + u * 9
					local R = 1.9 - 0.6 * u
					s.p.CFrame = CFrame.new(o + Vector3.new(math.cos(a) * R, 0.3 + 13 * L.inQuad(u) + 2 * u, math.sin(a) * R))
					s.p.Transparency = 0
					s.tr.Enabled = true
					s.dr.Rate = 60
				else
					s.p.Transparency = 1
					s.dr.Rate = 0
					if u >= 1 then s.tr.Enabled = false end
				end
			end
			if t >= SPIRAL and t < SPIRAL + 0.08 then L.punch(0.6, 0.15, C1, 0.12) end

			if not burst and t >= BURST then
				burst = true
				appear(C1, 0.3, hideTok)
				L.punch(2.1, 0.45, C1, 0.45)
				rain.Rate = 220 petals.Rate = 60 petals:Emit(30)
				burstP.CFrame = CFrame.new(o + Vector3.new(0, 15, 0)) dropBurst:Emit(40)
				L.groundWave(o, "ring_c.png", C2, 3, 24, 0.55)
			end
			if burst and t >= BURST + 0.6 then rain.Rate = 0 petals.Rate = 0 end

			if not out and t >= BURST + 0.15 then
				out = true
				for _, c in ipairs(cand) do c.fl.Rate = 0 c.smoke:Emit(8) c.smoke.Rate = 6 c.lt.Brightness = 0 end
			end
			if out and t >= BURST + 0.6 then for _, c in ipairs(cand) do c.smoke.Rate = 0 end end
			if not stamped and t >= BURST + 0.25 then
				stamped = true
				L.punch(0.9, 0.2, C1, 0.2)
				pool(o, 9, 1.4, 0.2)
			end
			if stamped then
				local u = c01((t - BURST - 0.25) / 0.12)
				local s2 = 7.5 * (1.5 - 0.5 * L.outQuad(u))
				stM.Scale, stCM.Scale = Vector3.new(s2, 1, s2), Vector3.new(s2 * 1.4, 1, s2 * 1.4)
				st.CFrame = CFrame.new(o + Vector3.new(0, 0.11, 0)) stC.CFrame = CFrame.new(o + Vector3.new(0, 0.1, 0))
				st.Transparency = math.max(0.1 + 0.9 * (1 - u), fade)
				stC.Transparency = math.max(0.3 + 0.7 * (1 - u), fade)
				L.tint(stM, W:Lerp(C1, u), 2.4)
			end
			if burst then fadeHl() end
		end, objs)
		task.delay(DUR + 0.1, function() setHidden(false, hideTok) end)
	end
	local cur = 1
	local function arrive(short)
		if short then return shorts[cur]() end
		return arriveFull()
	end


	local travel, ghostT, batT, pulseT, age, side = 0, 0, 0, 0, 0, 1
	local lastPos
	local function step(dt)
		age += dt
		local iw, on, sprint = ch.iw, ch.on, ch.sprint
		rig.main.Enabled = on
		rig.main.Lifetime = 0.3 + 0.4 * c01(ch.spd / 30)
		rig.mist.Rate = on and (8 + 14 * sprint) or 0
		rig.bats.Rate = on and 25 * sprint or 0
		if ch.dashStart and not savedLTM then

			local hideTok = setHidden(true)
			dashTok = hideTok
			burstP.CFrame = CFrame.new(ch.pos) batBurst:Emit(30)
			local p, e = swarm(ch.pos, 90)
			L.fx(0.35, function() p.CFrame = CFrame.new(ch.pos) end, { p })
			task.delay(0.35, function() setHidden(false, hideTok) burstP.CFrame = CFrame.new(ch.pos) batBurst:Emit(14) hl.FillColor, hl.FillTransparency = C1, 0.3 end)
		end
		if on then
			local dir = ch.spd > 0.1 and ch.vel.Unit or Vector3.zAxis
			if lastPos then travel += (Vector3.new(ch.pos.X, 0, ch.pos.Z) - Vector3.new(lastPos.X, 0, lastPos.Z)).Magnitude end
			if travel >= 4 then
				travel = 0 side = -side

				local fp = ch.feet + ch.hrp.CFrame.RightVector * 0.6 * side
				local p, m = L.mesh("disc.mesh", "glowui.png", GORE, 1.3, Vector3.new(1.6, 1, 1.6))
				local q, qm = L.mesh("disc.mesh", "cracks_b.png", C1, 1.6, Vector3.new(1.8, 1, 1.8))
				local rot = rnd(0, 6)
				L.fx(1.8, function(k)
					p.CFrame = CFrame.new(fp + Vector3.new(0, 0.05, 0))
					q.CFrame = CFrame.new(fp + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, rot, 0)
					local s = 1.2 + 0.8 * L.outQuad(c01(k / 0.15))
					m.Scale = Vector3.new(s, 1, s) qm.Scale = Vector3.new(s * 1.1, 1, s * 1.1)
					p.Transparency = 0.1 + 0.9 * c01((k - 0.4) / 0.6) q.Transparency = 0.4 + 0.6 * c01((k - 0.3) / 0.6)
				end, { p, q })
			end
			ghostT += dt
			if ch.spd > 10 and ghostT >= 0.16 - 0.06 * sprint then
				ghostT = 0
				local g = L.ghost(BLACK, Enum.Material.SmoothPlastic, 0.35)
				local gh = L.new("Highlight", { FillTransparency = 1, OutlineColor = C1, OutlineTransparency = 0.2, Adornee = g, DepthMode = Enum.HighlightDepthMode.Occluded }, L.root)
				L.fx(0.35, function(k) gh.OutlineTransparency = 0.2 + 0.8 * k end, { gh })
			end
			batT += dt
			if sprint > 0.2 and batT >= 0.35 then
				batT = 0
				burstP.CFrame = CFrame.new(ch.pos - dir * 1.5) batBurst:Emit(4)
			end
		end
		lastPos = ch.pos

		feetP.CFrame = ch.flat
		auraMist.Rate = 7 * iw
		gSig.CFrame = ch.flat * CFrame.new(0, 0.05, 0) * CFrame.Angles(0, -ch.clock * 0.2, 0)
		L.tint(gSigM, C1:Lerp(C2, 0.3 * ch.breathe), 1.6 + 0.6 * ch.breathe)
		gSig.Transparency = 1 - iw * 0.7
		gRing.CFrame = ch.flat * CFrame.new(0, 0.08, 0) * CFrame.Angles(0, ch.clock * 0.5, 0)
		gRing.Transparency = 1 - iw * 0.5
		gPool.CFrame = ch.flat * CFrame.new(0, 0.03, 0)
		gPool.Transparency = 1 - iw * 0.6
		for _, b in ipairs(bats) do
			local a = ch.clock * b.sp + b.ph
			b.p.CFrame = CFrame.new(ch.pos + Vector3.new(math.cos(a) * b.r, b.h - 2 + 0.5 * math.sin(a * 3), math.sin(a) * b.r))
			b.e.Rate = iw > 0.3 and 4 or 0
		end
		dripP.CFrame = ch.hrp.CFrame * CFrame.new(0, -0.6, -0.2)
		dripE.Rate = 1.2 * iw

		if iw > 0.8 then
			pulseT += dt
			if pulseT >= 3.5 then
				pulseT = 0
				L.groundWave(ch.feet, "glyph.png", C2, 4, 14, 0.9, 2.4)
				L.groundWave(ch.feet, "ring_c.png", C1, 2, 12, 0.7)
				burstP.CFrame = CFrame.new(ch.pos) batBurst:Emit(6) dropBurst:Emit(6)
				light.Brightness = 5
			end
		else
			pulseT = 2.2
		end
		local beat = 0.85 + 0.15 * math.max(0, math.sin(ch.clock * 5)) ^ 8
		light.Brightness = math.max(on and (1 + sprint) * beat or iw * 1.5 * beat, light.Brightness - dt * 8)
		hl.OutlineTransparency = 0.7 - 0.4 * iw * beat
		if hl.FillTransparency < 1 then hl.FillTransparency = math.min(1, hl.FillTransparency + dt * 0.8) end

		local hp = ch.head.Position + Vector3.new(0, 1.1 + 0.05 * math.sin(ch.clock * 1.6), 0)
		local a = 0.6 + 0.4 * iw
		local spin = ch.clock * 0.35
		local tilt = CFrame.Angles(math.rad(6) * math.sin(ch.clock * 0.7), 0, math.rad(6) * math.cos(ch.clock * 0.7))
		local base = CFrame.new(hp) * tilt
		crown.CFrame = base * CFrame.Angles(0, spin, 0) crown.Transparency = 1 - a * 0.95
		L.tint(crownM, C1:Lerp(C2, 0.35 * (beat - 0.85) / 0.15), 1.8 * beat)
		crownIn.CFrame = base * CFrame.new(0, -0.02, 0) * CFrame.Angles(0, -spin * 0.6, 0) crownIn.Transparency = 1 - a * 0.85
		crownG.CFrame = base * CFrame.new(0, -0.04, 0) crownG.Transparency = 1 - a * 0.4
		local cam = workspace.CurrentCamera.CFrame.Position
		for _, d in ipairs(hang) do
			d.g += dt * d.sp
			if d.g >= 1 then
				d.g = 0 d.sp = rnd(0.35, 0.6)
				fallP.CFrame = CFrame.new(d.pos or hp) fallE:Emit(1)
			end
			local th = d.a + spin
			local rim = (base * CFrame.new(math.cos(th) * 1.05, 0, math.sin(th) * 1.05)).Position
			local sw = L.outQuad(c01(d.g / 0.85))
			local len = 0.12 + 0.3 * sw
			local pos = rim - Vector3.new(0, len * 0.5 + 0.05 * sw, 0)
			d.pos = rim - Vector3.new(0, len, 0)

			local flat = Vector3.new(cam.X - pos.X, 0, cam.Z - pos.Z)
			local look = flat.Magnitude > 0.01 and CFrame.lookAt(pos, pos + flat) or CFrame.new(pos)
			d.p.CFrame = look * CFrame.Angles(math.rad(-90), 0, 0)
			d.m.Scale = Vector3.new(0.08 + 0.08 * sw, 1, len)
			d.p.Transparency = math.max(0.06, 1 - a * (0.4 + 0.6 * sw))
		end
		haloLight.Brightness = (1 + a) * beat

		tag.step(dt)
	end
	return { arrive = arrive, step = step, rebind = rebind, short = function(n) cur = n shorts[n]() end,
		hidden = function() return hideOwner ~= dashTok and savedLTM or nil end, rig = function() return rig end, stop = function() tag.bb:Destroy() setHidden(false) end }
end

System.StaffThemes.THEMES.inferno = function(L, C)
