									local v = pos:GetValueAtTime(t)
									if type(v) == "table" then cf = CFrame.new(v[1] or 0, v[2] or 0, v[3] or 0) * cf end
								end
								addKey(tracks, f.Name, { t = t, cf = cf })
								if t >= e then break end
								t = math.min(t + RATE, e)
							end
						end
						walk(f)
					end
				end
			end
			walk(seq)
