		end

		local function chooseSlot(drv, hum)
			local st, S = hum:GetState(), Enum.HumanoidStateType
			local own = drv.model == Player.Character
			local root = drv.model:FindFirstChild("HumanoidRootPart")
			local vel = root and root.AssemblyLinearVelocity or Vector3.zero
			local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
			local slot, scale = nil, 1


			if st == S.Jumping then slot = "jump"; drv.jumpUntil = os.clock() + 0.31
			elseif st == S.Freefall then slot = (drv.jumpUntil and os.clock() < drv.jumpUntil) and "jump" or "fall"
			elseif st == S.Climbing then slot = "climb"; scale = math.clamp(math.abs(vel.Y) / 8, 0, 2)
			elseif st == S.Swimming then slot = speed > 1 and "swim" or "swimidle"
			elseif own and (st == S.Seated or st == S.Dead or st == S.Ragdoll or st == S.FallingDown or st == S.GettingUp
				or st == S.PlatformStanding or st == S.Physics) then slot = nil
			elseif not own and (hum.Sit or hum.Health <= 0) then slot = nil
			elseif speed > 0.75 then
				if speed >= 12 then slot = "run"; scale = speed / 16 else slot = "walk"; scale = speed / 8 end
