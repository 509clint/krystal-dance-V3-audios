							pd.tailSettings[_tk] = _tv
						end
					elseif typeof(_tv) == "Vector3" then
						if _tv == _tv and _tv.Magnitude <= 1e3 then pd.tailSettings[_tk] = _tv end
					else
						pd.tailSettings[_tk] = _tv
					end
				end
			end
		end


