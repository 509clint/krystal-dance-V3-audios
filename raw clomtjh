			Size = NS({ K(0, 0.03), K(0.7, 0.12), K(1, 0) }) })
		holes[i] = { skP = skP, core = core, r = r, rm = rm, sk = sk, ph = i / 3 * math.pi * 2, rad = 3.6 + i * 0.25, h = 1.4 + i * 0.7, sp = 0.9 + 0.2 * i }
	end

	local shards = {}
	for i = 1, 6 do
		local p, m = shard(C1, rnd(0.25, 0.45))
		shards[i] = { p = p, m = m, ph = rnd(0, 6.28), rad = rnd(2.4, 3.4), h = rnd(0.4, 3.6), sp = rnd(0.3, 0.6), tilt = CFrame.Angles(rnd(0, 6), rnd(0, 6), rnd(0, 6)) }
	end

	local hCore = L.part({ Size = Vector3.new(3, 0.2, 3) })
