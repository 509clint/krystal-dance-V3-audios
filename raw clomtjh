	end


	local feetP = L.part({ Size = Vector3.new(2.4, 0.2, 2.4) })
	local auraFire = flameE(feetP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top, Speed = NR(5, 9),
		Size = NS({ K(0, 0.8), K(0.3, 2.2), K(1, 0.2) }), Lifetime = NR(0.5, 0.9) })
	local auraEmb = emberE(feetP, { Shape = Enum.ParticleEmitterShape.Box, Speed = NR(4, 9), Lifetime = NR(1, 2) })
	local burst = flameE(feetP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top, Speed = NR(12, 28),
		SpreadAngle = Vector2.new(80, 80), Drag = 2, Lifetime = NR(0.4, 0.8), Size = NS({ K(0, 1), K(0.3, 3), K(1, 0.5) }), Acceleration = Vector3.new(0, 10, 0) })
	local gMag, gMagM = L.mesh("disc.mesh", "cracks_b.png", C1, 1.8, Vector3.new(9, 1, 9))
	local gRing, gRingM = L.mesh("disc.mesh", "ring_c.png", C2, 2, Vector3.new(6, 1, 6))

	local halo, haloM = L.mesh("disc.mesh", "ring_c.png", C2, 2.4, Vector3.new(2.8, 1, 2.8))
	local crown = L.part()
