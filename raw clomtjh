		local at = L.new("Attachment", { Position = Vector3.new(math.cos(a) * 1.4, 0, math.sin(a) * 1.4) }, crown)
		local e = flameE(at, { EmissionDirection = Enum.NormalId.Top, Speed = NR(1.5, 2.5), Lifetime = NR(0.22, 0.34), Brightness = 2.2,
