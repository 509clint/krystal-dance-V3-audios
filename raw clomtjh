		local function load(x)
			local id = idOf(x)
			if not id then return nil end
			if clips[id] then return clips[id] end
			if failedAt[id] and os.clock() - failedAt[id] < 120 then return nil end
			local p = pending[id]
			if p then
				while pending[id] == p do task.wait() end
				return clips[id]
			end
			p = {}
			pending[id] = p
			local ok, clip = pcall(loadRaw, id)
			pending[id] = nil
			if not (ok and clip) then failedAt[id] = os.clock() else failedAt[id] = nil end
			return ok and clip or nil
		end

		local function sample(clip, t, out)
			for name, tr in pairs(clip.tracks) do
				local n = #tr
				if n == 1 or t <= tr[1].t then out[name] = tr[1].cf
				elseif t >= tr[n].t then out[name] = tr[n].cf
				else
					local lo, hi = 1, n
					while hi - lo > 1 do
						local mid = (lo + hi) // 2
						if tr[mid].t <= t then lo = mid else hi = mid end
					end
					local a, b = tr[lo], tr[hi]
					if a.constant then
						local jump = a.cdir == "In" or (a.cdir == "InOut" and (t - a.t) * 2 >= (b.t - a.t))
						out[name] = jump and b.cf or a.cf
					else
						local alpha = (t - a.t) / (b.t - a.t)
						if a.es then alpha = game:GetService("TweenService"):GetValue(alpha, a.es, a.ed) end
