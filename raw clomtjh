		else
			flareT = 1.8
		end
		local flick = 0.85 + 0.15 * math.sin(ch.clock * 23) * math.sin(ch.clock * 7)
		light.Brightness = math.max(on and (1 + 1.5 * sprint) * flick or iw * 1.8 * flick, light.Brightness - dt * 8)
		hl.OutlineTransparency = 0.75 - 0.45 * iw * flick

		local hp = ch.head.Position + Vector3.new(0, 1.2 + 0.08 * math.sin(ch.clock * 1.6), 0)
		local a = 0.55 + 0.45 * iw
		halo.CFrame = CFrame.new(hp) * CFrame.Angles(0, ch.clock * 1.2, 0)
		haloM.Scale = Vector3.new(2.8 + 0.12 * ch.breathe, 1, 2.8 + 0.12 * ch.breathe)
		halo.Transparency = 1 - a * 0.35
		L.tint(haloM, C2:Lerp(W, 0.3 * ch.breathe), 2.4)
		crown.CFrame = CFrame.new(hp) * CFrame.Angles(0, ch.clock * 1.2, 0)
		for _, c in ipairs(crownE) do c.e.Rate = c.ember and c.base * (on and 0.6 or 1) * a or 0 end
		crownLight.Brightness = (1.5 + 1.5 * a) * (0.85 + 0.15 * math.sin(ch.clock * 19))

		tag.step(dt)
	end
	return { arrive = arrive, step = step, rebind = rebind, short = function(n) cur = n shorts[n]() end, hidden = function() return hideOwner ~= dashTok and savedLTM or nil end, rig = function() return rig end, stop = function() tag.bb:Destroy() setHidden(false) end }
end


System.StaffThemes.THEMES.lightborn = function(L, C)
	local C1, C2, W = C.c1, C.c2, L.W
	local NS, CS, NR, K, CK = L.NS, L.CS, L.NR, L.K, L.CK
	local ch = L.ch
	local rnd, c01 = L.rnd, L.c01
	local PRISM = CS({ CK(0, Color3.fromRGB(255, 120, 120)), CK(0.2, Color3.fromRGB(255, 220, 110)), CK(0.4, Color3.fromRGB(140, 255, 160)),
		CK(0.6, Color3.fromRGB(120, 210, 255)), CK(0.8, Color3.fromRGB(190, 140, 255)), CK(1, Color3.fromRGB(255, 130, 220)) })

	local function featherE(parent, props)
		local p = { Texture = L.T("feather.png"), Color = CS(W, C2), LightEmission = 0.6, Brightness = 2.5,
			Size = NS({ K(0, 0.5), K(1, 0.35) }), Transparency = NS({ K(0, 1), K(0.1, 0), K(0.8, 0.1), K(1, 1) }),
			Lifetime = NR(2.5, 3.5), Speed = NR(0.5, 1.5), Rotation = NR(0, 360), RotSpeed = NR(-60, 60),
			Acceleration = Vector3.new(0, -1, 0), Drag = 0.8, SpreadAngle = Vector2.new(60, 60) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function moteE(parent, props)
		local p = { Texture = L.T("star.png"), Color = CS(W, C1), LightEmission = 1, Brightness = 4,
			Size = NS({ K(0, 0), K(0.3, 0.3), K(1, 0) }), Lifetime = NR(1, 1.8), Speed = NR(1, 2.5), Rotation = NR(0, 90),
			Acceleration = Vector3.new(0, 1.5, 0), Transparency = NS({ K(0, 1), K(0.2, 0), K(1, 1) }) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function prismE(parent, props)
		local p = { Texture = L.T("star.png"), Color = PRISM, LightEmission = 1, Brightness = 5, Size = NS({ K(0, 0), K(0.3, 0.5), K(1, 0) }),
			Lifetime = NR(0.5, 0.9), Speed = NR(8, 16), Drag = 3, SpreadAngle = Vector2.new(180, 180), Rotation = NR(0, 90) }
		for k, v in pairs(props or {}) do p[k] = v end
		return L.pe(parent, p)
	end
	local function faceCam(pos)
		local cp = workspace.CurrentCamera.CFrame.Position
		if (cp - pos).Magnitude < 0.05 then return CFrame.new(pos) end
		return CFrame.lookAt(pos, cp) * CFrame.Angles(math.rad(90), 0, 0)
	end


	local bigUntil = 0
	local function wings(gain, majestic)
		local wg = {}
		local tex = majestic and "wing_s.png" or "wing_b.png"

		local rx, rz = majestic and 0.46 or 0.42, majestic and 0.14 or 0.22
		for i, side in ipairs({ 1, -1 }) do
			local p, m = L.mesh("quad.mesh", tex, C2, gain or 2.2)
			p.Transparency = 1
			local w = { p = p, m = m, side = side }
			if majestic then
				w.bp, w.bm = L.mesh("quad.mesh", tex, C1, (gain or 2.2) * 0.9)
				w.bp.Transparency = 1
				w.sp = L.part({ Size = Vector3.one })
				w.mo = moteE(w.sp, { Shape = Enum.ParticleEmitterShape.Box, Rate = 0, Speed = NR(0.5, 1.5), Lifetime = NR(0.8, 1.4), Size = NS({ K(0, 0), K(0.3, 0.35), K(1, 0) }) })
				w.fe = featherE(w.sp, { Shape = Enum.ParticleEmitterShape.Box, Rate = 0, Speed = NR(0.5, 2), Lifetime = NR(1.5, 2.5) })
			end
			wg[i] = w
		end
		function wg.set(cf, open, lift, S, tr, col, g)
			for i = 1, 2 do
				local w = wg[i]
				local sweep = (1 - open) * math.rad(80) + math.rad(18)
				local pivot = cf * CFrame.new(w.side * 0.25, majestic and -0.3 or -0.6, 0.6) * CFrame.Angles(0, w.side == 1 and 0 or math.pi, 0)
					* CFrame.Angles(0, -w.side * sweep, 0) * CFrame.Angles(0, 0, lift + (majestic and math.rad(-8) or math.rad(-10)) + (1 - open) * math.rad(-25))
				w.p.CFrame = pivot * CFrame.Angles(math.rad(-90), 0, 0) * CFrame.new(rx * S, 0, rz * S)
				w.m.Scale = Vector3.new(S, 1, S)
				w.p.Transparency = tr
				if col then L.tint(w.m, col, g or 2.2) end
				if w.bp and tr < 0.95 then bigUntil = os.clock() + 0.1 end
				if w.bp then
					local bS = S * 1.06
					local bpiv = pivot - cf.LookVector * 0.12
					w.bp.CFrame = bpiv * CFrame.Angles(math.rad(-90), 0, 0) * CFrame.new(rx * bS, 0, rz * bS)
					w.bm.Scale = Vector3.new(bS, 1, bS)
					w.bp.Transparency = math.min(1, tr + 0.25)
					w.sp.CFrame = pivot * CFrame.new(S * 0.3, S * 0.15, 0)
					w.sp.Size = Vector3.new(S * 0.6, S * 0.4, 0.4)
					local on = tr < 0.6
					w.mo.Rate = on and 40 or 0
					w.fe.Rate = on and 6 or 0
				end
			end
		end
		wg.objs = {}
		for i = 1, 2 do local w = wg[i] for _, x in ipairs({ w.p, w.bp, w.sp }) do wg.objs[#wg.objs + 1] = x end end
		return wg
	end

	local function shaft(top, bot, w)
		local a, b = L.att(top), L.att(bot)
		local soft = L.beam(a, b, { Width0 = w, Width1 = w, Brightness = 2.5, Segments = 2, Color = CS(C1, C2), Transparency = NS({ K(0, 1), K(0.4, 0.5), K(1, 0.3) }) })
		local core = L.beam(a, b, { Width0 = w * 0.3, Width1 = w * 0.3, Brightness = 6, Segments = 2, Color = CS(W), Transparency = NS({ K(0, 1), K(0.4, 0.3), K(1, 0) }) })
		return { a = a, b = b, soft = soft, core = core, objs = { a, b, soft, core } }
	end
	local function vring(pos, col, from, to, life, gain)
		local p, m = L.mesh("disc.mesh", "ring_c.png", col, gain or 2.6)
		L.fx(life, function(k) local s = from + (to - from) * L.outQuad(k) m.Scale = Vector3.new(s, 1, s)
			p.CFrame = CFrame.new(pos + Vector3.new(0, 0.2 + 5 * L.outQuad(k), 0)) p.Transparency = 0.1 + 0.9 * k end, { p })
	end


	local feetP = L.part({ Size = Vector3.new(5, 0.2, 5) })
	local skyP = L.part({ Size = Vector3.new(8, 0.2, 8) })
	local burstP = L.part({ Size = Vector3.one * 2 })
	local auraMotes = moteE(feetP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Top })
	local auraFeath = featherE(skyP, { Shape = Enum.ParticleEmitterShape.Box, EmissionDirection = Enum.NormalId.Bottom })
	local burst = prismE(burstP, {})
	local fBurst = featherE(burstP, { Speed = NR(8, 16), Drag = 2.5, SpreadAngle = Vector2.new(180, 180), Lifetime = NR(1.5, 2.5) })
	local gSig, gSigM = L.mesh("disc.mesh", "glyph.png", C1, 1.8, Vector3.new(8, 1, 8))
	local gRing, gRingM = L.mesh("disc.mesh", "ring_c.png", C2, 2.2, Vector3.new(6, 1, 6))
	local idleWings = wings(2)

	local halo, haloM = L.mesh("disc.mesh", "ring_c.png", C2, 3.2, Vector3.new(2.4, 1, 2.4))
	local haloG, haloGM = L.mesh("disc.mesh", "glowui.png", C1, 1.2, Vector3.new(4, 1, 4))
	local sun, sunM = L.mesh("disc.mesh", "glowui.png", C1, 1.5, Vector3.new(5, 1, 5))
	local haloP = L.part({ Size = Vector3.new(2.4, 0.2, 2.4) })
	local haloMotes = moteE(haloP, { Shape = Enum.ParticleEmitterShape.Box, Rate = 8, Speed = NR(0.2, 0.6), Lifetime = NR(0.6, 1), Size = NS({ K(0, 0), K(0.3, 0.2), K(1, 0) }) })
	local sparks = {}
	for i = 1, 4 do
		local p = L.part({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.18, Material = Enum.Material.Neon, Color = W, Transparency = 0 })
		sparks[i] = p
	end
	local haloLight = L.new("PointLight", { Color = C2, Range = 12, Brightness = 2, Shadows = false }, haloP)

	local rig, light, hl = {}, nil, nil
	local function rebind()
		for _, o in ipairs(rig) do o:Destroy() end
		rig = {}
		local hrp = ch.hrp
		local function att(pos) local a = L.new("Attachment", { Position = pos }, hrp) rig[#rig + 1] = a return a end
		local function trail(a0, a1, props) local t = L.new("Trail", props, hrp) t.Attachment0, t.Attachment1 = a0, a1 rig[#rig + 1] = t return t end
		rig.main = trail(att(Vector3.new(0, 1.2, 0.3)), att(Vector3.new(0, -1.5, 0.3)), { Texture = L.T("beamb.png"), LightEmission = 1, Brightness = 3,
			Lifetime = 0.45, FaceCamera = true, Enabled = false, Color = CS({ CK(0, W), CK(0.4, C2), CK(1, C1) }),
			Transparency = NS({ K(0, 0.2), K(1, 1) }), WidthScale = NS({ K(0, 1), K(1, 0.3) }) })
		local back = att(Vector3.new(0, 0.6, 0.6))
		rig.feath = featherE(back, { Speed = NR(1, 3), Lifetime = NR(1.5, 2.2), EmissionDirection = Enum.NormalId.Back })
		rig.motes = moteE(att(Vector3.new(0, -1, 0.4)), { Speed = NR(1, 3), Lifetime = NR(0.6, 1) })
		for _, e in ipairs({ rig.feath, rig.motes }) do rig[#rig + 1] = e end
		light = L.new("PointLight", { Color = C2, Range = 16, Brightness = 0, Shadows = false }, hrp) rig[#rig + 1] = light
		hl = L.new("Highlight", { FillTransparency = 1, OutlineColor = C2, Adornee = ch.char, DepthMode = Enum.HighlightDepthMode.Occluded }, L.root)
		rig[#rig + 1] = hl
	end
	rebind()
	local tag = System.StaffThemes.headTag(L, "lightborn", C1, C2, { c1 = C1, c2 = C2, grad = CS({ CK(0, C1), CK(0.35, C2), CK(0.5, W), CK(0.65, C2), CK(1, C1) }) })

	local function blessFlash(o, s)
		burstP.CFrame = CFrame.new(o + Vector3.new(0, 2, 0))
		burst:Emit(math.floor(50 * s)) fBurst:Emit(math.floor(30 * s))
		L.groundWave(o, "ring_c.png", W, 3, 50 * s, 0.6)
		L.groundWave(o, "ring_c.png", C1, 3, 34 * s, 0.9)
		L.groundWave(o, "glyph.png", C2, 4, 28 * s, 1.4, 2.2)
		vring(o, C2, 3, 7 * s, 0.9)
		light.Brightness = 9
	end

	local function bodyFlare(col)
		hl.FillColor, hl.FillTransparency = col or W, 0.1
	end




	local savedLTM, hideChar, hideOwner, hideGen, dashTok = nil, nil, nil, 0, nil
	local function setHidden(on, tok)
		if on then
			hideGen += 1
			local my = hideGen
			hideOwner = my
			task.delay(15, function() setHidden(false, my) end)
			if savedLTM and hideChar == ch.char then return my end
			if not ch.char then return my end
			savedLTM, hideChar = {}, ch.char
			for _, d in ipairs(ch.char:GetDescendants()) do
				if d:IsA("BasePart") or d:IsA("Decal") then savedLTM[d] = d.LocalTransparencyModifier d.LocalTransparencyModifier = 1 end
			end
			return my
		elseif savedLTM then
			if tok and tok ~= hideOwner then return end
			for d, v in pairs(savedLTM) do if d.Parent then d.LocalTransparencyModifier = v end end
			if tok and tok ~= dashTok then L.punch(1.1, 0.3) end
			savedLTM, hideChar, hideOwner = nil, nil, nil
		end
	end
	local function camBasis() return L.facing() end

	local function figure(col)
		local m = Instance.new("Model")
		local rel = {}
		local root = ch.hrp.CFrame
		for _, p in ipairs(ch.char:GetDescendants()) do
			local ltm = savedLTM and savedLTM[p] or (p:IsA("BasePart") and p.LocalTransparencyModifier) or 1
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" and p.Transparency < 1 and ltm < 1 then
				local g = p:Clone()
				for _, d in ipairs(g:GetChildren()) do if not d:IsA("DataModelMesh") then d:Destroy() end end
				g.Anchored, g.CanCollide, g.CanQuery, g.CanTouch, g.CastShadow = true, false, false, false, false
				g.Material, g.Color = Enum.Material.Neon, col
				if g:IsA("MeshPart") then g.TextureID = "" end
				g.Transparency = 1
				g.Parent = m
				rel[g] = root:ToObjectSpace(p.CFrame)
			end
		end
		m.Parent = L.root
		local f = { model = m, rel = rel }
		function f.set(cf, tr, c)
			for g, r in pairs(rel) do
				if g.Parent then g.CFrame = cf * r g.Transparency = tr if c then g.Color = c end end
			end
		end
		return f
	end
	local function appear(col, tok)
		setHidden(false, tok)
		bodyFlare(col)
	end



	local function arriveFull()
		local o = ch.feet
		local DUR, STAIR0, DOOR, WALK0, HIT = 10.6, 1.3, 3.15, 3.8, 6.8
		L.after(DUR - 2.6, function() L.handoff(o, "glyph.png", C1, 30, 8, 2.4, 1.8) end)
		local fwd, right = camBasis()
		local hipH = ch.hrp.Position.Y - o.Y
		local fig = figure(W)
		local hideTok = setHidden(true)
		task.delay(DUR + 0.1, function() setHidden(false, hideTok) end)
		local S = L.screen(DUR)
		S.dimFn = function(t) return 0.25 * c01(t / 1) * (1 - c01((t - HIT) / 1)) end
		S.style, S.c1, S.c2 = "lightborn", C1, C2 S.boxFn = function(t) return c01((t - 0.2) / 0.6) * (1 - c01((t - (DUR - 1)) / 0.8)) end
		S.tintFn = function(t) return C1:Lerp(W, 0.35), 0.5 * c01(t / 1.5) * (1 - c01((t - HIT - 1.5) / 2.5)) end
