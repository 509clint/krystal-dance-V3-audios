function _RCA.fnv(s, h)
	local lshift, bxor = bit32.lshift, bit32.bxor
	for i = 1, #s, 256 do
		for _, b in ipairs({ string.byte(s, i, math.min(i + 255, #s)) }) do
			h = bxor(h, b)
			h = (h + lshift(h, 1) + lshift(h, 4) + lshift(h, 7) + lshift(h, 8) + lshift(h, 24)) % 4294967296
		end
	end
	return h
end
