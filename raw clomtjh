			local c = L.clean(l)
			if not c then return false end
			L.pushUndo()
			c.sub = l.sub
			c.ag = L.dupOffset(l)
			local nl = {}
			for i, x in ipairs(list) do nl[i] = x end
			nl[#nl + 1] = c
