			for i = 1, ONJ do
				local a = a0 - (i - 1) * span
				ouroJ[i] = hp + Vector3.new(math.cos(a) * 1.4, 0.08 * math.sin(a * 3 + ch.clock * 2), math.sin(a) * 1.4)
