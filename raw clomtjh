	local all = {}
	for _, a in ipairs(add) do all[#all + 1] = { a = a } end
	for _, r in ipairs(rem) do all[#all + 1] = { r = r } end
	for i = 1, #all, _RCA.ROSTER_MAX do
		local ev = { k = "ro", pid = p.pid, jid = p.jid, add = {}, rem = {} }
		for j = i, math.min(i + _RCA.ROSTER_MAX - 1, #all) do
			local x = all[j]
