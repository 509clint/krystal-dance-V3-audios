	local hRim2, hRim2M = L.mesh("disc.mesh", "ring_c.png", C1, 2.6, Vector3.new(3.3, 1, 3.3))
	local hSuck = L.pe(hCore, { Texture = L.T("spark.png"), Color = CS({ CK(0, C1), CK(0.7, C2), CK(1, W) }), LightEmission = 1, Brightness = 3,
		Shape = Enum.ParticleEmitterShape.Disc, ShapeInOut = Enum.ParticleEmitterShapeInOut.Inward, ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface,
		Speed = NR(3, 4.5), Lifetime = NR(0.28, 0.36), Size = NS({ K(0, 0.04), K(0.7, 0.14), K(1, 0) }), Rate = 120,
		Transparency = NS({ K(0, 1), K(0.3, 0), K(1, 0.3) }), Orientation = Enum.ParticleOrientation.VelocityParallel, Squash = NS(-1.2), LockedToPart = true })
	local hDark = darkE(hCore, { Shape = Enum.ParticleEmitterShape.Disc, Rate = 20, Speed = NR(0, 0.3), Lifetime = NR(0.5, 0.8),
		Size = NS({ K(0, 0.6), K(1, 1.2) }), LockedToPart = true })
	local hLight = L.new("PointLight", { Color = C1, Range = 10, Brightness = 1.5, Shadows = false }, hCore)

	local rig, light, hl = {}, nil, nil
	local function rebind()
		for _, o in ipairs(rig) do o:Destroy() end
		rig = {}
		local hrp = ch.hrp
		local function att(pos) local a = L.new("Attachment", { Position = pos }, hrp) rig[#rig + 1] = a return a end
		local function trail(a0, a1, props) local t = L.new("Trail", props, hrp) t.Attachment0, t.Attachment1 = a0, a1 rig[#rig + 1] = t return t end

		rig.main = trail(att(Vector3.new(0, 1.2, 0.3)), att(Vector3.new(0, -1.5, 0.3)), { Texture = L.T("beamb.png"), LightEmission = 0, Brightness = 1,
			Lifetime = 0.45, FaceCamera = true, Enabled = false, Color = CS(BLACK, DUSK), Transparency = NS({ K(0, 0.1), K(1, 1) }), WidthScale = NS({ K(0, 1), K(1, 0.4) }) })
		rig.edge = trail(att(Vector3.new(0, 1.3, 0.3)), att(Vector3.new(0, 1.0, 0.3)), { Texture = L.T("beamb.png"), LightEmission = 1, Brightness = 4,
			Lifetime = 0.45, FaceCamera = true, Enabled = false, Color = CS({ CK(0, W), CK(0.3, C2), CK(1, C1) }), Transparency = NS({ K(0, 0), K(1, 1) }) })
		rig.edge2 = trail(att(Vector3.new(0, -1.35, 0.3)), att(Vector3.new(0, -1.6, 0.3)), { Texture = L.T("beamb.png"), LightEmission = 1, Brightness = 4,
			Lifetime = 0.45, FaceCamera = true, Enabled = false, Color = CS({ CK(0, W), CK(0.3, C1), CK(1, C2) }), Transparency = NS({ K(0, 0), K(1, 1) }) })
		local back = att(Vector3.new(0, -0.2, 0.6))
		rig.dark = darkE(back, { Shape = Enum.ParticleEmitterShape.Sphere, Speed = NR(0.5, 1), Lifetime = NR(0.6, 1), Size = NS({ K(0, 1.4), K(1, 2.6) }) })
		for _, e in ipairs({ rig.dark }) do rig[#rig + 1] = e end
		light = L.new("PointLight", { Color = C1, Range = 14, Brightness = 0, Shadows = false }, hrp) rig[#rig + 1] = light
