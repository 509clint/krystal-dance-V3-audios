		local done = false
		local objs = { fa, fb, fDark, fLit, body } for _, o in ipairs(h.objs) do objs[#objs + 1] = o end
		for _, q in ipairs(strands) do objs[#objs + 1] = q.a0 objs[#objs + 1] = q.a1 objs[#objs + 1] = q.b end
		L.fx(DUR, function(k, t)
