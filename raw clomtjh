		end

		local function step(drv, dt)
			local model = drv.model
			local hum = model:FindFirstChildOfClass("Humanoid")
			if not hum then return end
			if os.clock() > drv.nextScan then
				local stale = not drv.motorsOk
				if not stale then for _, m in pairs(drv.motors) do if not m.Parent then stale = true; break end end end
				if stale then scan(drv) else drv.nextScan = os.clock() + 0.5 end
			end
			if os.clock() > (drv.nextPose or 0) then
				drv.nextPose = os.clock() + 0.1
